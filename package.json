{
  "name": "alan-mozhoor-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.3"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && npm run check:links",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:links": "node scripts/check-links.mjs",
    "audit:browser": "node scripts/browser-audit.mjs",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "test": "node scripts/smoke-test.mjs",
    "audit:interactions": "node scripts/interaction-audit.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "astro": "7.3.8",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "lighthouse": "13.5.0",
    "playwright-core": "1.64.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
