---
import type { GetStaticPaths } from "astro";
import { projects } from "../../data/projects";
import type { Project } from "../../data/projects";
import { labels } from "../../content/site";
import { localLinks } from "../../data/links";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import TextLink from "../../components/TextLink.astro";
export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<BaseLayout title={project.title} description={project.summary}>
  <div class="mb-6">
    <TextLink href={localLinks.projects}>{labels.backToProjects}</TextLink>
  </div>
  <CaseStudy project={project} />
</BaseLayout>
