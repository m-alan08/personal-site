---
import type { GetStaticPaths } from "astro";
import { orderedProjects } from "../../data/projects";
import type { Project } from "../../data/projects";
import { labels } from "../../content/site";
import { sectionLink } from "../../data/sections";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import TextLink from "../../components/TextLink.astro";
import ProjectPager from "../../components/ProjectPager.astro";
export const getStaticPaths = (() =>
  orderedProjects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      previous: orderedProjects[index - 1],
      next: orderedProjects[index + 1],
    },
  }))) satisfies GetStaticPaths;
interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}
const { project, previous, next } = Astro.props;
---

<BaseLayout title={project.title} description={project.summary}>
  <p class="mb-8 text-sm">
    <TextLink href={sectionLink("projects")}>{labels.backToProjects}</TextLink>
  </p>
  <CaseStudy project={project} />
  <ProjectPager previous={previous} next={next} />
</BaseLayout>
