---
import type { GetStaticPaths } from "astro";
import { projects } from "../../data/projects";
import type { Project } from "../../data/projects";
import { labels } from "../../content/site";
import { sectionLink } from "../../data/sections";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import TextLink from "../../components/TextLink.astro";
export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<BaseLayout title={project.title} description={project.summary}>
  <p class="mb-8 text-sm">
    <TextLink href={sectionLink("projects")}>{labels.backToProjects}</TextLink>
  </p>
  <CaseStudy project={project} />
</BaseLayout>
