---
import BaseLayout from "../layouts/BaseLayout.astro";
import TextLink from "../components/TextLink.astro";
import { pages } from "../content/site";
import { localLinks } from "../data/links";
---

<BaseLayout
  title={pages.notFound.title}
  description={pages.notFound.meta}
  noindex
>
  <h1 class="font-display text-4xl tracking-tight sm:text-5xl">
    {pages.notFound.title}
  </h1>
  <p class="mt-5 max-w-reading text-muted">{pages.notFound.description}</p>
  <p class="mt-4">
    <TextLink href={localLinks.home}>{pages.notFound.home}</TextLink>
  </p>
</BaseLayout>
