---
import BaseLayout from "../layouts/BaseLayout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import Ticks from "../components/Ticks.astro";
import { pages } from "../content/site";
import { localLinks } from "../data/links";
import { sectionLink } from "../data/sections";
---

<BaseLayout
  title={pages.notFound.title}
  description={pages.notFound.meta}
  noindex
>
  <section class="border-t border-line py-16 sm:py-24">
    <div class="flex items-center gap-3 text-muted">
      <Ticks />
      <span class="text-label tabular-nums">404</span>
    </div>
    <h1 class="mt-5 text-display text-ink">{pages.notFound.title}</h1>
    <p class="mt-5 max-w-reading text-muted">{pages.notFound.description}</p>
    <ul class="mt-8 flex flex-wrap gap-3" role="list">
      <li>
        <ButtonLink href={localLinks.home} variant="primary">
          {pages.notFound.home}
        </ButtonLink>
      </li>
      <li>
        <ButtonLink href={sectionLink("projects")} arrow>
          {pages.notFound.projects}
        </ButtonLink>
      </li>
    </ul>
  </section>
</BaseLayout>
