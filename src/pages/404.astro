---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { pages } from "../content/site";
import { localLinks } from "../data/links";
import { sectionLink } from "../data/sections";
---

<BaseLayout
  title={pages.notFound.title}
  description={pages.notFound.meta}
  noindex
>
  <h1 class="font-display text-4xl tracking-tight sm:text-5xl">
    {pages.notFound.title}
  </h1>
  <p class="mt-5 max-w-reading text-muted">{pages.notFound.description}</p>
  <ul class="mt-4 flex flex-wrap gap-x-6" role="list">
    <li>
      <ArrowLink href={localLinks.home} title={pages.notFound.home} />
    </li>
    <li>
      <ArrowLink
        href={sectionLink("projects")}
        title={pages.notFound.projects}
      />
    </li>
  </ul>
</BaseLayout>
