---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialIcons from "../components/SocialIcons.astro";
import portrait from "../assets/portrait.jpg";
import EntryList from "../components/EntryList.astro";
import InterestGrid from "../components/InterestGrid.astro";
import ProjectList from "../components/ProjectList.astro";
import Section from "../components/Section.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../content/site";
import {
  profile,
  researchInterests,
  researchNote,
  writing,
  experience,
} from "../content/profile";
import { projects } from "../data/projects";
import { projectLink } from "../data/links";
import { sectionLabel } from "../data/sections";
const ordered = [...projects].sort(
  (a, b) => (a.order ?? Infinity) - (b.order ?? Infinity),
);
const featured = ordered.filter((project) => project.featured !== false);
const other = ordered.filter((project) => project.featured === false);
---

<BaseLayout title={site.name} description={site.description}>
  <section aria-labelledby="intro-heading" class="pb-16 sm:pb-20">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,1fr)_15rem] sm:gap-12">
      <div class="min-w-0">
        <p class="text-xs uppercase tracking-[0.2em] text-accent">
          {profile.tagline}
        </p>
        <h1
          id="intro-heading"
          class="mt-4 font-display text-5xl leading-none tracking-tight sm:text-7xl"
        >
          {profile.name}
        </h1>
        <p class="mt-6 max-w-reading text-lg leading-relaxed">
          {profile.headline}
        </p>
        {profile.intro.map((paragraph) => (
          <p class="mt-4 max-w-reading text-muted">{paragraph}</p>
        ))}
        <div class="mt-5 -ml-3">
          <SocialIcons />
        </div>
      </div>
      <div class="relative order-first w-48 self-start sm:order-last sm:mt-3 sm:w-60">
        <div
          aria-hidden="true"
          class="absolute inset-0 translate-x-2.5 translate-y-2.5 rounded-xl border-2 border-accent"
        ></div>
        <Image
          src={portrait}
          alt={profile.portraitAlt}
          width={240}
          height={240}
          densities={[1, 2]}
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="relative aspect-square w-full rounded-xl border border-line object-cover"
        />
      </div>
    </div>
    <div class="mt-14 rounded-xl border border-line bg-surface p-6 sm:p-8">
      <h2 class="font-display text-xl italic tracking-tight">
        {profile.currentLabel}
      </h2>
      <dl class="mt-6 grid gap-6 sm:grid-cols-2 sm:gap-x-10">
        {profile.current.map((item) => (
          <div class="border-l-2 border-accent pl-4">
            <dt class="text-xs uppercase tracking-[0.2em] text-accent">
              {item.label}
            </dt>
            <dd class="mt-2 text-sm leading-relaxed">{item.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
  <Section id="about" title={sectionLabel("about")}>
    <div class="max-w-reading space-y-4">
      {profile.about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <p class="mt-6 text-sm text-muted">
      {profile.education.school} · {profile.education.field} ·{" "}
      {profile.education.graduation}
    </p>
  </Section>
  <Section id="projects" title={sectionLabel("projects")}>
    <ProjectList entries={featured} />
    {other.length > 0 && (
      <div class="mt-10 border-t border-line pt-8">
        <EntryList
          entries={other.map((project) => ({
            title: project.title,
            meta: project.status,
            summary: project.summary,
            href: projectLink(project.slug),
          }))}
        />
      </div>
    )}
  </Section>
  <Section id="research" title={sectionLabel("research")}>
    <p class="mb-8 max-w-reading text-muted">{researchNote}</p>
    <InterestGrid entries={researchInterests} />
  </Section>
  <Section id="writing" title={sectionLabel("writing")}>
    <p class="mb-8 max-w-reading text-muted">{writing.intro}</p>
    <EntryList
      entries={writing.links.map((link) => ({
        title: link.title,
        summary: link.note,
        href: link.href,
      }))}
    />
  </Section>
  <Section id="experience" title={sectionLabel("experience")}>
    <EntryList
      entries={experience.map((entry) => ({
        title: `${entry.role}, ${entry.organization}`,
        meta: entry.period,
        summary: entry.summary,
        href: entry.href,
      }))}
    />
  </Section>
  <Section id="contact" title={sectionLabel("contact")}>
    <SocialLinks detailed />
  </Section>
</BaseLayout>
