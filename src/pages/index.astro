---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialIcons from "../components/SocialIcons.astro";
import portrait from "../assets/portrait.jpg";
import EntryList from "../components/EntryList.astro";
import ProjectList from "../components/ProjectList.astro";
import Section from "../components/Section.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../content/site";
import {
  profile,
  researchInterests,
  researchNote,
  writing,
  experience,
} from "../content/profile";
import { projects } from "../data/projects";
import { projectLink } from "../data/links";
import { sectionLabel } from "../data/sections";
const ordered = [...projects].sort(
  (a, b) => (a.order ?? Infinity) - (b.order ?? Infinity),
);
const featured = ordered.filter((project) => project.featured !== false);
const other = ordered.filter((project) => project.featured === false);
---

<BaseLayout title={site.name} description={site.description}>
  <section aria-labelledby="intro-heading" class="pb-16 sm:pb-20">
    <div class="grid gap-8 sm:grid-cols-[15rem_minmax(0,1fr)] sm:gap-10">
      <div class="w-48 self-start rounded-xl border-2 border-accent bg-surface p-1.5 sm:mt-2 sm:w-60 sm:-rotate-2">
        <Image
          src={portrait}
          alt={profile.portraitAlt}
          width={240}
          height={240}
          densities={[1, 2]}
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="aspect-square w-full rounded-lg object-cover"
        />
      </div>
      <div class="min-w-0">
        <p class="font-display text-lg italic text-accent">{profile.kicker}</p>
        <h1
          id="intro-heading"
          class="mt-1 font-display text-5xl leading-none tracking-tight sm:text-6xl"
        >
          {profile.name}
        </h1>
        <div class="mt-3 -ml-3">
          <SocialIcons />
        </div>
        <div class="mt-5 max-w-reading space-y-4">
          <p class="text-lg leading-relaxed">{profile.headline}</p>
          {profile.intro.map((paragraph) => (
            <p class="text-muted">{paragraph}</p>
          ))}
          <p class="text-muted">{profile.nowLabel}</p>
          <ul class="list-disc space-y-2 pl-5 marker:text-accent" role="list">
            {profile.now.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="text-muted">{profile.previouslyLabel}</p>
          <ul
            class="list-disc space-y-2 pl-5 text-muted marker:text-accent"
            role="list"
          >
            {profile.previously.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
  <Section id="about" title={sectionLabel("about")}>
    <div class="max-w-reading space-y-4">
      {profile.about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <p class="mt-6 text-sm text-muted">
      {profile.education.school} · {profile.education.field} ·{" "}
      {profile.education.graduation}
    </p>
  </Section>
  <Section id="projects" title={sectionLabel("projects")}>
    <ProjectList entries={featured} />
    {other.length > 0 && (
      <div class="mt-10 border-t border-line pt-8">
        <EntryList
          entries={other.map((project) => ({
            title: project.title,
            meta: project.status,
            summary: project.summary,
            href: projectLink(project.slug),
          }))}
        />
      </div>
    )}
  </Section>
  <Section id="research" title={sectionLabel("research")}>
    <p class="mb-8 max-w-reading text-muted">{researchNote}</p>
    <EntryList entries={researchInterests} />
  </Section>
  <Section id="writing" title={sectionLabel("writing")}>
    <p class="mb-8 max-w-reading text-muted">{writing.intro}</p>
    <EntryList
      entries={writing.links.map((link) => ({
        title: link.title,
        summary: link.note,
        href: link.href,
      }))}
    />
  </Section>
  <Section id="experience" title={sectionLabel("experience")}>
    <EntryList
      entries={experience.map((entry) => ({
        title: `${entry.role}, ${entry.organization}`,
        meta: entry.period,
        summary: entry.summary,
        href: entry.href,
      }))}
    />
  </Section>
  <Section id="contact" title={sectionLabel("contact")}>
    <SocialLinks detailed />
  </Section>
</BaseLayout>
