---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "../components/ProjectList.astro";
import SocialLinks from "../components/SocialLinks.astro";
import TextLink from "../components/TextLink.astro";
import { site } from "../content/site";
import { localLinks } from "../data/links";
---

<BaseLayout title={site.name} description={site.description}>
  <section
    class="grid gap-10 pb-16 md:grid-cols-[2fr_1fr] md:gap-16 md:pb-24"
    aria-labelledby="intro-heading"
  >
    <div>
      <h1
        id="intro-heading"
        class="text-5xl font-semibold leading-[1.1] tracking-tight sm:text-6xl lg:text-7xl"
      >
        {site.name}
      </h1>
      <p class="mt-5 max-w-reading text-xl text-muted">{site.introduction}</p>
      <div class="mt-6 max-w-reading space-y-3">
        {site.bio.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="mt-6">
        <SocialLinks />
      </div>
    </div>
    <div class="self-end border-l-2 border-accent pl-6">
      <h2 class="text-lg font-semibold">{site.focusHeading}</h2>
      <ul class="mt-3 space-y-2 text-muted" role="list">
        {site.focus.map((focus) => (
          <li>{focus}</li>
        ))}
      </ul>
    </div>
  </section>
  <section aria-labelledby="projects-heading">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-x-8 gap-y-2">
      <h2
        id="projects-heading"
        class="text-2xl font-semibold tracking-tight sm:text-3xl"
      >
        {site.selectedProjects}
      </h2>
      <TextLink href={localLinks.projects}>{site.allProjects}</TextLink>
    </div>
    <ProjectList heading="h3" />
  </section>
</BaseLayout>
