---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "../components/ProjectList.astro";
import Section from "../components/Section.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../content/site";
import { sectionLabel } from "../data/sections";
---

<BaseLayout title={site.title} description={site.description}>
  <section aria-labelledby="intro-heading" class="pb-16 sm:pb-20">
    <h1
      id="intro-heading"
      class="text-4xl font-medium tracking-tight sm:text-5xl"
    >
      {site.name}
    </h1>
    <p class="mt-5 max-w-reading text-lg text-muted">{site.introduction}</p>
    <div class="mt-6">
      <SocialLinks />
    </div>
  </section>
  <Section id="about" title={sectionLabel("about")}>
    <div class="max-w-reading space-y-4">
      {site.bio.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </Section>
  <Section id="projects" title={sectionLabel("projects")}>
    <ProjectList />
  </Section>
  <Section id="contact" title={sectionLabel("contact")}>
    <SocialLinks />
  </Section>
</BaseLayout>
