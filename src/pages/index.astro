---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/sections/About.astro";
import Contact from "../components/sections/Contact.astro";
import Experience from "../components/sections/Experience.astro";
import Exploring from "../components/sections/Exploring.astro";
import Explorer from "../components/sections/Explorer.astro";
import Hero from "../components/sections/Hero.astro";
import Playground from "../components/sections/Playground.astro";
import Projects from "../components/sections/Projects.astro";
import ProofStrip from "../components/sections/ProofStrip.astro";
import Writing from "../components/sections/Writing.astro";
import { site } from "../content/site";
---

<BaseLayout title={site.name} description={site.description} wide>
  <Hero />
  <Playground />
  <ProofStrip />
  <About />
  <Projects />
  <Exploring />
  <Explorer />
  <Writing />
  <Experience />
  <Contact />
</BaseLayout>
