---
import { socialLinks } from "../data/links";
import SocialIcon from "./SocialIcon.astro";
const entries = socialLinks.filter((link) => link.kind !== "email");
---

<ul
  class="-ml-3 flex flex-wrap gap-x-2 gap-y-1 print:ml-0 print:block"
  role="list"
>
  {entries.map((link) => (
    <li>
      <a
        href={link.href}
        class="group inline-flex min-h-11 items-center gap-2 rounded-md px-3 text-ink transition-colors duration-150 hover:text-accent motion-reduce:transition-none print:inline print:min-h-0 print:px-0"
      >
        <SocialIcon
          kind={link.kind}
          class="size-4 text-muted transition-colors duration-150 group-hover:text-accent motion-reduce:transition-none print:hidden"
        />
        <span>{link.label}</span>
      </a>
    </li>
  ))}
</ul>
