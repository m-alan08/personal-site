---
import { socialLinks } from "../data/links";
import TextLink from "./TextLink.astro";
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---

{detailed ? (
  <dl class="grid gap-x-8 sm:grid-cols-[10rem_minmax(0,1fr)]">
    {socialLinks.map((link) => (
      <>
        <dt class="pt-2.5 text-sm text-muted">{link.label}</dt>
        <dd class="m-0 mb-1 min-w-0 break-words">
          <TextLink href={link.href}>{link.display}</TextLink>
        </dd>
      </>
    ))}
  </dl>
) : (
  <ul class="flex flex-wrap gap-x-6" role="list">
    {socialLinks.map((link) => (
      <li>
        <TextLink href={link.href}>{link.label}</TextLink>
      </li>
    ))}
  </ul>
)}
