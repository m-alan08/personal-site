---
import { labels } from "../content/site";
import { links, optionalLinks } from "../data/links";
import { resumeHref } from "../data/resume";
import TextLink from "./TextLink.astro";
const items = [
  { label: labels.github, href: links.github },
  { label: labels.x, href: optionalLinks.x },
  { label: labels.email, href: optionalLinks.email },
  { label: labels.resume, href: resumeHref },
].filter((item) => item.href);
---

<ul class="flex flex-wrap gap-x-6" role="list">
  {items.map((item) => (
    <li>
      <TextLink href={item.href}>{item.label}</TextLink>
    </li>
  ))}
</ul>
