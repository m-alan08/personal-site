---
import { socialLinks } from "../data/links";
import TextLink from "./TextLink.astro";
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
const rows = Math.ceil(socialLinks.length / 2);
---

{detailed ? (
  <dl
    class="grid gap-x-16 lg:grid-flow-col lg:grid-cols-2 lg:grid-rows-[repeat(var(--rows),auto)]"
    style={`--rows: ${rows}`}
  >
    {socialLinks.map((link) => (
      <div class="border-t border-line pt-4 pb-2">
        <dt class="text-xs uppercase tracking-[0.2em] text-muted">
          {link.label}
        </dt>
        <dd class="m-0 mt-1 min-w-0 break-words">
          <TextLink href={link.href}>{link.display}</TextLink>
        </dd>
      </div>
    ))}
  </dl>
) : (
  <ul class="flex flex-wrap gap-x-6" role="list">
    {socialLinks.map((link) => (
      <li>
        <TextLink href={link.href}>{link.label}</TextLink>
      </li>
    ))}
  </ul>
)}
