---
import { labels } from "../content/site";
import { links, localLinks, optionalLinks } from "../data/links";
import TextLink from "./TextLink.astro";
const socialLinks = [
  { label: labels.resume, href: localLinks.resume },
  { label: labels.github, href: links.github },
  {
    label: labels.x,
    href: optionalLinks.x,
  },
  { label: labels.email, href: optionalLinks.email },
].filter((link) => link.href);
---

<ul class="flex flex-wrap gap-x-7 gap-y-2" role="list">
  {socialLinks.map((link) => (
    <li>
      <TextLink href={link.href}>{link.label}</TextLink>
    </li>
  ))}
</ul>
