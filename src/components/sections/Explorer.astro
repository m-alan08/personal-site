---
import ExplorerChart from "../explorer/ExplorerChart.astro";
import ExplorerChoice from "../explorer/ExplorerChoice.astro";
import ExplorerTable from "../explorer/ExplorerTable.astro";
import HyphenSafeText from "../HyphenSafeText.astro";
import Section from "../Section.astro";
import TextLink from "../TextLink.astro";
import {
  bitWidths,
  datasets,
  explorerCopy,
  explorerDefaults,
  methods,
} from "../../data/explorerData";
import { projects } from "../../data/projects";

const limitation = projects.find((project) => project.slug === "quantrl-fetch")
  ?.limitations[0];
const source = datasets[0].source;
const lastIndex = bitWidths.length - 1;
const legend = "text-label uppercase text-muted";
---

<Section
  id="explorer"
  title={explorerCopy.title}
  eyebrow={explorerCopy.label}
  data-explorer
>
  <div class="min-w-0">
    <p class="max-w-reading text-muted">
      <HyphenSafeText text={explorerCopy.intro} />
    </p>
    <div data-explorer-static class="mt-8 grid gap-6 lg:grid-cols-2">
      {datasets.map((dataset) => (
        <ExplorerTable dataset={dataset} />
      ))}
    </div>
    <div
      data-explorer-ui
      hidden
      class="mt-8 overflow-hidden rounded-xl border border-line bg-surface"
    >
      <form data-explorer-form>
        <div class="flex flex-wrap items-center gap-x-8 gap-y-4 border-b border-line px-4 py-3 sm:px-6">
          <fieldset class="flex flex-wrap items-center gap-2">
            <legend class="sr-only">{explorerCopy.taskLegend}</legend>
            <span aria-hidden="true" class={legend}>
              {explorerCopy.taskLegend}
            </span>
            {datasets.map((dataset) => (
              <ExplorerChoice
                name="explorer-task"
                value={dataset.task}
                label={dataset.label}
                checked={dataset.task === explorerDefaults.task}
              />
            ))}
          </fieldset>
          <fieldset class="flex flex-wrap items-center gap-2">
            <legend class="sr-only">{explorerCopy.methodLegend}</legend>
            <span aria-hidden="true" class={legend}>
              {explorerCopy.methodLegend}
            </span>
            {methods.map((method) => (
              <ExplorerChoice
                name="explorer-method"
                value={method.id}
                label={method.label}
                checked={method.id === explorerDefaults.method}
              />
            ))}
          </fieldset>
        </div>
        <div class="grid gap-8 p-5 sm:p-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-10">
          <div class="min-w-0">
            <p class={legend}>{explorerCopy.successLabel}</p>
            <p
              data-explorer-value
              class="mt-3 text-display tabular-nums text-accent"
            ></p>
            <p
              data-explorer-seeds
              class="mt-3 min-h-6 text-small text-muted"
            ></p>
            <div aria-hidden="true" class="mt-5 h-1.5 rounded-full bg-line">
              <div data-explorer-bar class="h-full rounded-full bg-ink"></div>
            </div>
            <p data-explorer-selection class="mt-4 text-small text-ink"></p>
          </div>
          <div class="min-w-0">
            <ExplorerChart />
            <div class="mt-4">
              <div class="flex items-baseline justify-between gap-4">
                <label for="explorer-bits" class={legend}>
                  {explorerCopy.bitsLabel}
                </label>
                <span
                  data-explorer-bits
                  class="font-mono text-small tabular-nums text-ink"
                ></span>
              </div>
              <input
                id="explorer-bits"
                name="explorer-bits"
                type="range"
                min="0"
                max={lastIndex}
                step="1"
                value={bitWidths.indexOf(explorerDefaults.bits)}
                class="mt-2 block h-11 w-full cursor-pointer accent-ink"
              />
              <ol
                aria-hidden="true"
                class="relative h-5 font-mono text-label tabular-nums text-muted"
              >
                {bitWidths.map((bits, index) => (
                  <li
                    class="absolute top-0 -translate-x-1/2"
                    style={`left: calc(8px + (100% - 16px) * ${index / lastIndex})`}
                  >
                    {bits}
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>
      </form>
      <p
        data-explorer-status
        class="sr-only"
        aria-live="polite"
        aria-atomic="true"
      ></p>
    </div>
    {limitation && (
      <p class="mt-8 max-w-reading text-small text-muted">{limitation}</p>
    )}
    <p class="mt-2 text-small">
      <TextLink href={source}>{explorerCopy.sourceLabel}</TextLink>
    </p>
  </div>
</Section>

<script>
  const root = document.querySelector<HTMLElement>("[data-explorer]");
  if (root) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void import("../explorer/explorer").then(({ mountExplorer }) =>
          mountExplorer(root),
        );
      },
      { rootMargin: "200px 0px" },
    );
    observer.observe(root);
  }
</script>
