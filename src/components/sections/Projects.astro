---
import ProjectList from "../ProjectList.astro";
import Section from "../Section.astro";
import { site } from "../../content/site";
import { orderedProjects, type Project } from "../../data/projects";
const isInProgress = (project: Project) =>
  project.tier === "in-progress" || project.featured === false;
const finished = orderedProjects.filter((project) => !isInProgress(project));
const inProgress = orderedProjects.filter(isInProgress);
---

<Section id="projects" title={site.selectedProjects} stacked>
  <ProjectList
    features={finished.slice(0, 2)}
    standard={finished.slice(2)}
    inProgress={inProgress}
  />
</Section>
