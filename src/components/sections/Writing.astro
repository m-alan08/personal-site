---
import HyphenSafeText from "../HyphenSafeText.astro";
import LegacyAnchor from "../LegacyAnchor.astro";
import Section from "../Section.astro";
import WritingCard from "../WritingCard.astro";
import { writing } from "../../content/profile";
import { labels } from "../../content/site";
import { xSeriesPosts } from "../../content/xSeries";
import { assertThreadsFresh, threads } from "../../data/exploring";
import { sectionLabel } from "../../data/sections";

assertThreadsFresh();
---

<LegacyAnchor id="research" />
<LegacyAnchor id="exploring" />
<Section id="writing" title={sectionLabel("writing")}>
  <ul class="divide-y divide-line border-y border-line" role="list">
    {writing.links.map((link) => (
      <WritingCard title={link.title} href={link.href} />
    ))}
    {xSeriesPosts.map((post) => (
      <WritingCard
        title={post.title}
        href={post.href}
        date={post.date}
        source={labels.x}
      />
    ))}
    {threads.map((thread) => (
      <li class="grid min-h-11 gap-x-6 gap-y-1 py-4 sm:grid-cols-[5.5rem_minmax(0,1fr)_auto] sm:items-baseline">
        <span class="text-label text-muted">{labels.exploring}</span>
        <span class="min-w-0 text-ink">
          <HyphenSafeText text={thread.title} />
        </span>
        <span class="text-label text-muted">{thread.status}</span>
      </li>
    ))}
  </ul>
</Section>
