---
import HyphenSafeText from "../HyphenSafeText.astro";
import Section from "../Section.astro";
import WritingCard from "../WritingCard.astro";
import { writing } from "../../content/profile";
import { labels } from "../../content/site";
import { xSeriesPosts } from "../../content/xSeries";
import { sectionIndex, sectionLabel } from "../../data/sections";
---

<Section
  id="writing"
  title={sectionLabel("writing")}
  index={sectionIndex("writing")}
>
  <p class="mb-8 max-w-reading text-muted">
    <HyphenSafeText text={writing.intro} />
  </p>
  <ul class="divide-y divide-line border-y border-line" role="list">
    {writing.links.map((link) => (
      <WritingCard title={link.title} href={link.href} note={link.note} />
    ))}
    {xSeriesPosts.map((post) => (
      <WritingCard
        title={post.title}
        href={post.href}
        date={post.date}
        source={labels.x}
      />
    ))}
  </ul>
</Section>
