---
import ExplorerChoice from "../explorer/ExplorerChoice.astro";
import HyphenSafeText from "../HyphenSafeText.astro";
import TextLink from "../TextLink.astro";
import RobotFigure from "../playground/RobotFigure.astro";
import { playgroundCopy as copy } from "../../content/playground";
import {
  playgroundDefaults,
  playgroundModelPath,
  playgroundVariants,
} from "../../data/playground";
import { localPath } from "../../data/links";

const metrics = [
  { key: "distance", label: copy.metrics.distance },
  { key: "steps", label: copy.metrics.steps },
  { key: "latency", label: copy.metrics.latency },
];
const rows = Object.entries(copy.benchmarkRows);
const legend = "font-mono text-label uppercase tracking-[0.2em] text-muted";
---

<section
  id="playground"
  aria-labelledby="playground-heading"
  data-playground
  data-model-base={localPath(playgroundModelPath)}
  class="grid gap-6 border-t border-line py-section-compact md:gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16"
>
  <div class="lg:sticky lg:top-24 lg:self-start">
    <p aria-hidden="true" class={legend}>
      {copy.label}
    </p>
    <h2 id="playground-heading" class="mt-1.5 text-h2 text-ink">
      {copy.title}
    </h2>
    <span aria-hidden="true" class="mt-4 block h-px w-8 bg-accent/70"></span>
    <p class="mt-6 max-w-reading text-muted lg:text-small">
      <HyphenSafeText text={copy.intro} />
    </p>
  </div>
  <div class="min-w-0">
    <div class="overflow-hidden rounded-xl border border-line bg-surface">
      <div
        data-playground-stage
        tabindex="0"
        role="group"
        aria-label={copy.stageLabel}
        aria-describedby="playground-status"
        class="relative mx-auto max-w-[46rem] cursor-crosshair touch-pan-y outline-none focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-ink"
      >
        <RobotFigure />
        <p
          data-playground-bubble
          hidden
          class="pointer-events-none absolute top-[12%] left-[4%] rounded-full border border-control bg-canvas px-3 py-1.5 font-mono text-label text-ink"
        >
          {copy.hint}
        </p>
        <noscript>
          <p class="absolute top-[12%] left-[4%] text-small text-muted">
            {copy.noScript}
          </p>
        </noscript>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-line px-4 py-3 sm:px-6">
        <p
          id="playground-status"
          data-playground-status
          aria-live="polite"
          aria-atomic="true"
          class="min-h-6 font-mono text-small text-ink"
        >
          {copy.hint}
        </p>
        <dl class="flex flex-wrap gap-x-6 gap-y-1 font-mono text-label">
          {metrics.map((metric) => (
            <div class="flex gap-2">
              <dt class="uppercase tracking-[0.12em] text-muted">
                {metric.label}
              </dt>
              <dd data-metric={metric.key} class="tabular-nums text-ink">
                {copy.notYet}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
    <details data-playground-details class="group mt-3">
      <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 text-small text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink [&::-webkit-details-marker]:hidden">
        <span class="underline decoration-accent decoration-1 underline-offset-[5px] hover:decoration-ink">
          {copy.explore}
        </span>
        <span
          aria-hidden="true"
          class="font-mono text-muted group-open:rotate-90"
        >
          &gt;
        </span>
      </summary>
      <form data-playground-form class="mt-4 grid gap-8">
        <div class="grid gap-6 xl:grid-cols-[auto_minmax(0,1fr)] xl:gap-10">
          <fieldset>
            <legend class={legend}>{copy.controllerLegend}</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {Object.entries(copy.controllers).map(([value, label]) => (
                <ExplorerChoice
                  name="playground-controller"
                  value={value}
                  label={label}
                  checked={value === playgroundDefaults.controller}
                />
              ))}
            </div>
          </fieldset>
          <div>
            <label for="playground-variant" class={legend}>
              {copy.precisionLegend}
            </label>
            <select
              id="playground-variant"
              name="playground-variant"
              data-playground-precision
              class="mt-3 block min-h-11 rounded-full border border-control bg-canvas px-4 text-small text-ink hover:border-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink disabled:cursor-not-allowed disabled:text-muted"
            >
              {playgroundVariants.map((variant) => (
                <option
                  value={variant.id}
                  selected={variant.id === playgroundDefaults.variant}
                >
                  {variant.label}
                </option>
              ))}
            </select>
          </div>
        </div>
        <div class="grid gap-6 md:grid-cols-2 md:gap-10">
          <div>
            <div class="flex items-baseline justify-between gap-4">
              <label for="playground-depth" class={legend}>
                {copy.depthLabel}
              </label>
              <output
                data-playground-depth
                for="playground-depth"
                class="font-mono text-small text-ink"
              ></output>
            </div>
            <input
              id="playground-depth"
              name="playground-depth"
              type="range"
              min="-15"
              max="15"
              step="1"
              value="0"
              class="mt-2 block h-11 w-full cursor-pointer accent-ink"
            />
            <p class="text-small text-muted">{copy.depthNote}</p>
          </div>
          <div class="flex flex-wrap items-start gap-3">
            <button
              type="button"
              data-playground-replay
              class="min-h-11 rounded-full border border-control px-4 text-small text-ink hover:border-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink disabled:cursor-not-allowed disabled:text-muted"
            >
              {copy.replay}
            </button>
            <button
              type="button"
              data-playground-benchmark
              class="min-h-11 rounded-full border border-control px-4 text-small text-ink hover:border-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink disabled:cursor-not-allowed disabled:text-muted"
            >
              {copy.benchmark}
            </button>
          </div>
        </div>
      </form>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[22rem] text-left text-small">
          <thead class="font-mono text-label uppercase tracking-[0.12em] text-muted">
            <tr>
              {copy.benchmarkHeaders.map((header) => (
                <th
                  scope="col"
                  class="border-b border-line py-2 pr-4 font-medium"
                >
                  {header}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="font-mono tabular-nums">
            {rows.map(([key, label]) => (
              <tr data-benchmark-row={key}>
                <th
                  scope="row"
                  class="border-b border-line py-2 pr-4 font-sans font-normal text-muted"
                >
                  {label}
                </th>
                <td
                  data-cell="success"
                  class="border-b border-line py-2 pr-4 text-ink"
                >
                  {copy.notYet}
                </td>
                <td
                  data-cell="distance"
                  class="border-b border-line py-2 pr-4 text-ink"
                >
                  {copy.notYet}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p
          data-playground-benchmark-note
          class="mt-3 min-h-6 text-small text-muted"
        ></p>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2 md:gap-10">
        <div>
          <h3 class="text-small font-semibold text-ink">{copy.realTitle}</h3>
          <p class="mt-2 text-small text-muted">
            <HyphenSafeText text={copy.real} />
          </p>
        </div>
        <div>
          <h3 class="text-small font-semibold text-ink">
            {copy.simplifiedTitle}
          </h3>
          <p class="mt-2 text-small text-muted">
            <HyphenSafeText text={copy.simplified} />
          </p>
        </div>
      </div>
      <p
        data-playground-mode-note
        class="mt-6 max-w-reading text-small text-muted"
      >
        <HyphenSafeText text={copy.quantNote} />
      </p>
      <p class="mt-2 text-small">
        <TextLink href={copy.source}>{copy.sourceLabel}</TextLink>
      </p>
    </details>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-playground]");
  const stage = root?.querySelector<HTMLElement>("[data-playground-stage]");
  const bubble = root?.querySelector<HTMLElement>("[data-playground-bubble]");
  if (root && stage && bubble) {
    bubble.hidden = false;
    let pending: { clientX: number; clientY: number } | null = null;
    let started = false;
    const remember = (event: MouseEvent) => {
      pending = { clientX: event.clientX, clientY: event.clientY };
    };
    const start = () => {
      if (started) return;
      started = true;
      void import("../playground/playground").then(({ mountPlayground }) => {
        stage.removeEventListener("click", remember);
        mountPlayground(root, pending);
      });
    };
    stage.addEventListener("click", remember);
    stage.addEventListener("pointerenter", start);
    stage.addEventListener("pointerdown", start);
    root.addEventListener("focusin", start);
  }
</script>
