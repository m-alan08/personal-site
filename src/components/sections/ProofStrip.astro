---
import HyphenSafeText from "../HyphenSafeText.astro";
import { hero } from "../../content/hero";
---

<section
  aria-labelledby="proof-heading"
  class="border-t border-line py-section-compact"
>
  <h2 id="proof-heading" class="sr-only">
    {hero.proofHeading}
  </h2>
  <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
    {hero.proof.map((stat) => (
      <div class="flex flex-col-reverse gap-2">
        <dt class="text-small text-muted">
          <span>
            <HyphenSafeText text={stat.label} />
          </span>
        </dt>
        <dd
          class:list={[
            "font-display text-h2 tabular-nums",
            stat.numeric ? "text-accent" : "text-ink",
          ]}
        >
          {stat.value}
        </dd>
      </div>
    ))}
  </dl>
</section>
