---
import HyphenSafeText from "../HyphenSafeText.astro";
import LegacyAnchor from "../LegacyAnchor.astro";
import Section from "../Section.astro";
import TextLink from "../TextLink.astro";
import { experience, profile } from "../../content/profile";
import { labels } from "../../content/site";
import { resumeHref } from "../../data/resume";
import { sectionLabel } from "../../data/sections";

const previous = experience.filter(
  (entry) => !entry.period.endsWith("present"),
);
---

<LegacyAnchor id="about" />
<Section id="experience" title={sectionLabel("experience")}>
  <div class="grid gap-14 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
    <div>
      <h3 class="text-eyebrow uppercase text-muted">{profile.nowLabel}</h3>
      <ul class="mt-6 grid gap-7" role="list">
        {profile.current.map((item) => (
          <li class="grid gap-1.5">
            <span class="font-mono text-label uppercase text-muted">
              {item.label}
            </span>
            <span class="max-w-reading text-ink">
              <HyphenSafeText text={item.text} />
            </span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="text-eyebrow uppercase text-muted">
        {profile.previouslyLabel}
      </h3>
      <ul class="mt-6 grid gap-7" role="list">
        {previous.map((entry) => (
          <li class="grid gap-1">
            <span class="font-display text-h3 text-ink">
              {entry.organization}
            </span>
            <span class="text-ink">{entry.role}</span>
            <span class="font-mono text-label text-muted">{entry.period}</span>
          </li>
        ))}
      </ul>
      {resumeHref && (
        <p class="mt-8">
          <TextLink href={resumeHref}>{labels.resume}</TextLink>
        </p>
      )}
    </div>
  </div>
</Section>
