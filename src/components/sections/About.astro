---
import { Image } from "astro:assets";
import HyphenSafeText from "../HyphenSafeText.astro";
import Section from "../Section.astro";
import SocialIcons from "../SocialIcons.astro";
import aboutPhoto from "../../assets/about-photo.jpg";
import { profile } from "../../content/profile";
import { sectionLabel } from "../../data/sections";

const { city, shortName, graduation } = profile.education;
const caption = [
  city,
  shortName,
  graduation.charAt(0).toLowerCase() + graduation.slice(1),
].join(", ");
---

<Section id="about" title={sectionLabel("about")} stacked>
  <div class="grid gap-8 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-10 lg:grid-cols-[14rem_minmax(0,1fr)_minmax(0,15rem)] xl:grid-cols-[17rem_minmax(0,1fr)_minmax(0,16rem)] xl:gap-14">
    <figure class="max-w-48 sm:row-span-2 sm:max-w-none lg:row-span-1">
      <Image
        src={aboutPhoto}
        alt={profile.aboutPhotoAlt}
        widths={[320, 480, 640]}
        sizes="(min-width: 1280px) 17rem, (min-width: 1024px) 14rem, 13rem"
        format="webp"
        class="aspect-[4/5] w-full rounded-2xl object-cover object-[50%_30%]"
      />
      <figcaption class="mt-3 text-small text-muted">{caption}</figcaption>
    </figure>
    <div class="grid max-w-reading content-start gap-6">
      <div class="space-y-4">
        {profile.about.map((paragraph) => (
          <p>
            <HyphenSafeText text={paragraph} />
          </p>
        ))}
      </div>
      <SocialIcons kinds={["github", "x", "linkedin"]} labeled />
    </div>
    <div class="grid content-start gap-6 sm:col-start-2 lg:col-start-3 lg:border-l lg:border-line lg:pl-8">
      <div class="max-w-reading">
        <h3 class="text-eyebrow uppercase text-muted">
          {profile.aboutCurrentLabel}
        </h3>
        <p class="mt-2 text-small text-ink">
          <HyphenSafeText text={profile.aboutCurrent} />
        </p>
      </div>
      <div>
        <h3 class="text-eyebrow uppercase text-muted">{profile.focusLabel}</h3>
        <ul class="mt-2.5 flex list-none flex-wrap gap-1.5 p-0" role="list">
          {profile.focus.map((item) => (
            <li class="rounded-full border border-hairline px-2.5 py-1 text-label text-muted">
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Section>
