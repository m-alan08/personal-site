---
import { Image } from "astro:assets";
import ButtonLink from "../ButtonLink.astro";
import HyphenSafeText from "../HyphenSafeText.astro";
import portrait from "../../assets/portrait.jpg";
import { profile } from "../../content/profile";
import { socialLinks } from "../../data/links";
import { socialIcons } from "../../data/socialIcons";

const ctaKinds = ["github", "x", "linkedin", "email"] as const;
const ctas = ctaKinds
  .map((kind) => socialLinks.find((link) => link.kind === kind))
  .filter((link) => link !== undefined);
---

<section
  aria-labelledby="intro-heading"
  class="py-section-spacious"
  data-reveal
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_23rem] lg:gap-16">
    <div class="min-w-0">
      <p class="text-eyebrow uppercase text-muted">{profile.tagline}</p>
      <h1 id="intro-heading" class="mt-6 font-display text-display text-ink">
        {profile.name}
      </h1>
      <p class="mt-7 max-w-[36rem] text-xl leading-snug tracking-tight text-ink sm:text-2xl">
        <HyphenSafeText text={profile.headline} />
      </p>
      {profile.intro.map((paragraph) => (
        <p class="mt-5 max-w-[36rem] text-muted">
          <HyphenSafeText text={paragraph} />
        </p>
      ))}
      <p class="mt-6 flex items-center gap-2.5 text-small text-muted">
        <span aria-hidden="true" class="size-1.5 rounded-full bg-ink/60"></span>
        {profile.availability}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        {ctas.map((link) => {
          const icon = socialIcons[link.kind];
          return (
            <ButtonLink
              href={link.href}
              variant="secondary"
              glow
              newTab={link.kind !== "email"}
            >
              <svg
                aria-hidden="true"
                viewBox={icon.viewBox}
                class="size-4"
                fill={icon.stroke ? "none" : "currentColor"}
                stroke={icon.stroke ? "currentColor" : "none"}
                stroke-width={icon.stroke ? 1.6 : undefined}
                stroke-linejoin="round"
              >
                <path d={icon.path} />
              </svg>
              {link.label}
            </ButtonLink>
          );
        })}
      </div>
    </div>
    <div class="relative isolate w-56 sm:w-64 lg:w-full">
      <div
        aria-hidden="true"
        class="atmo-portrait pointer-events-none absolute -inset-12 -z-10 lg:-inset-x-10 lg:-inset-y-20 xl:-inset-x-14"
      ></div>
      <Image
        src={portrait}
        alt={profile.portraitAlt}
        width={368}
        height={460}
        fit="cover"
        position="center"
        densities={[1, 2]}
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] w-full rounded-2xl border border-hairline object-cover object-[48%_50%] lg:absolute lg:inset-0 lg:aspect-auto lg:h-full"
      />
    </div>
  </div>
</section>
