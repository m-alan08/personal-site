---
import { Image } from "astro:assets";
import ButtonLink from "../ButtonLink.astro";
import HyphenSafeText from "../HyphenSafeText.astro";
import Ticks from "../Ticks.astro";
import portrait from "../../assets/portrait.jpg";
import { profile } from "../../content/profile";
import { socialLinks } from "../../data/links";
import { socialIcons } from "../../data/socialIcons";

const ctaKinds = ["github", "resume", "email"] as const;
const ctas = ctaKinds
  .map((kind) => socialLinks.find((link) => link.kind === kind))
  .filter((link) => link !== undefined);
---

<section
  aria-labelledby="intro-heading"
  class="py-section-spacious"
  data-reveal
>
  <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16">
    <div class="min-w-0">
      <p class="flex items-center gap-2.5 text-eyebrow uppercase text-muted">
        <Ticks class="text-control" />
        {profile.tagline}
      </p>
      <h1 id="intro-heading" class="mt-6 font-display text-display text-ink">
        {profile.name}
      </h1>
      <p class="mt-7 max-w-[36rem] text-xl leading-snug tracking-tight text-ink sm:text-2xl">
        <HyphenSafeText text={profile.headline} />
      </p>
      {profile.intro.map((paragraph) => (
        <p class="mt-5 max-w-reading text-muted">
          <HyphenSafeText text={paragraph} />
        </p>
      ))}
      <p class="mt-6 flex items-center gap-2.5 text-small text-muted">
        <span aria-hidden="true" class="size-1.5 rounded-full bg-ink/60"></span>
        {profile.availability}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        {ctas.map((link, index) => {
          const icon = socialIcons[link.kind];
          return (
            <ButtonLink
              href={link.href}
              variant={index === 0 ? "primary" : "secondary"}
            >
              <svg
                aria-hidden="true"
                viewBox={icon.viewBox}
                class="size-4"
                fill={icon.stroke ? "none" : "currentColor"}
                stroke={icon.stroke ? "currentColor" : "none"}
                stroke-width={icon.stroke ? 1.6 : undefined}
                stroke-linejoin="round"
              >
                <path d={icon.path} />
              </svg>
              {link.label}
            </ButtonLink>
          );
        })}
      </div>
    </div>
    <Image
      src={portrait}
      alt={profile.portraitAlt}
      width={240}
      height={240}
      densities={[1, 2]}
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="aspect-square w-44 rounded-2xl border border-hairline object-cover lg:w-full"
    />
  </div>
</section>
