---
import HeroAction from "../HeroAction.astro";
import HyphenSafeText from "../HyphenSafeText.astro";
import QuantizationChart from "../QuantizationChart.astro";
import SocialIcons from "../SocialIcons.astro";
import { hero } from "../../content/hero";
import { profile } from "../../content/profile";
import { optionalLinks, socialLinks } from "../../data/links";

const resume = socialLinks.find((link) => link.kind === "resume")?.href ?? "";
const actions = [
  { label: hero.actions.projects, href: "#projects", primary: true },
  { label: hero.actions.resume, href: resume, primary: false },
  { label: hero.actions.email, href: optionalLinks.email, primary: false },
].filter((action) => action.href);
---

<section aria-labelledby="intro-heading" class="pb-section-compact">
  <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-16">
    <div class="min-w-0">
      <h1 id="intro-heading" class="font-display text-display text-ink">
        {profile.name}
      </h1>
      <p class="mt-6 max-w-reading text-lg leading-relaxed lg:text-xl">
        <HyphenSafeText text={profile.headline} />
      </p>
      <ul class="mt-8 flex flex-wrap gap-3" role="list">
        {actions.map((action) => (
          <li>
            <HeroAction href={action.href} primary={action.primary}>
              {action.label}
            </HeroAction>
          </li>
        ))}
      </ul>
      <div class="mt-5">
        <SocialIcons kinds={["github", "x", "linkedin"]} />
      </div>
    </div>
    <QuantizationChart />
  </div>
  <div class="mt-16 border-t border-line pt-8">
    <h2 class="font-mono text-label uppercase text-ink">{hero.now}</h2>
    <dl class="mt-5 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      {profile.current.map((item) => (
        <div>
          <dt class="font-mono text-label uppercase text-muted">
            {item.label}
          </dt>
          <dd class="mt-2 text-small">
            <HyphenSafeText text={item.text} />
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
