---
import ControlLoopDiagram from "../ControlLoopDiagram.astro";
import HyphenSafeText from "../HyphenSafeText.astro";
import InterestGrid from "../InterestGrid.astro";
import RobotArmElevation from "../RobotArmElevation.astro";
import Section from "../Section.astro";
import SectionFigure from "../SectionFigure.astro";
import { figures } from "../../content/figures";
import { researchInterests, researchNote } from "../../content/profile";
import { sectionLabel } from "../../data/sections";
---

<Section id="research" title={sectionLabel("research")}>
  <SectionFigure slot="aside" caption={figures.arm}>
    <RobotArmElevation />
  </SectionFigure>
  <SectionFigure slot="aside" caption={figures.loop.caption}>
    <ControlLoopDiagram />
  </SectionFigure>
  <p class="mb-8 max-w-reading text-muted">
    <HyphenSafeText text={researchNote} />
  </p>
  <InterestGrid entries={researchInterests} />
</Section>
