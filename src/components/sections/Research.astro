---
import HierarchyDiagram from "../HierarchyDiagram.astro";
import HyphenSafeText from "../HyphenSafeText.astro";
import InterestGrid from "../InterestGrid.astro";
import Section from "../Section.astro";
import { researchInterests, researchNote } from "../../content/profile";
import { sectionLabel } from "../../data/sections";
---

<Section id="research" title={sectionLabel("research")}>
  <p class="mb-8 max-w-reading text-muted">
    <HyphenSafeText text={researchNote} />
  </p>
  <InterestGrid entries={researchInterests} />
  <div class="mt-12 border-t border-line pt-8">
    <HierarchyDiagram />
  </div>
</Section>
