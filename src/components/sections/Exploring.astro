---
import ArrowLink from "../ArrowLink.astro";
import HierarchyDiagram from "../HierarchyDiagram.astro";
import HyphenSafeText from "../HyphenSafeText.astro";
import Section from "../Section.astro";
import {
  assertThreadsFresh,
  exploringIntro,
  exploringLabels,
  threads,
} from "../../data/exploring";
import { sectionLabel } from "../../data/sections";

assertThreadsFresh();

const figureThread = "agentic-orchestration";
const monthYear = new Intl.DateTimeFormat("en-US", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const updatedLabel = (date: string) =>
  `${exploringLabels.updated} ${monthYear.format(new Date(`${date}T00:00:00Z`))}`;
---

<span
  id="research"
  aria-hidden="true"
  class="block scroll-mt-8 sm:scroll-mt-20"
></span>
<Section id="exploring" title={sectionLabel("exploring")}>
  <p class="mb-8 max-w-reading text-muted">{exploringIntro}</p>
  <ol class="grid gap-6" role="list">
    {threads.map((thread) => (
      <li>
        <article
          aria-labelledby={`${thread.id}-title`}
          class="rounded-xl border border-hairline bg-surface p-5 sm:p-6"
        >
          <p class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-label text-muted">
            <span class="text-ink">{thread.status}</span>
            <span>{updatedLabel(thread.updated)}</span>
          </p>
          <h3 id={`${thread.id}-title`} class="mt-3 text-h3 text-ink">
            <HyphenSafeText text={thread.title} />
          </h3>
          <div
            class:list={[
              thread.id === figureThread &&
                "lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:gap-10",
              thread.id !== figureThread &&
                thread.directions?.length &&
                "xl:grid xl:grid-cols-[minmax(0,1fr)_minmax(0,16rem)] xl:gap-10",
            ]}
          >
            <div class="max-w-reading">
              <p class="mt-3 text-ink">
                <HyphenSafeText text={thread.question} />
              </p>
              <p class="mt-3 max-w-reading text-small text-muted">
                <HyphenSafeText text={thread.whyItMatters} />
              </p>
              {thread.readings.length > 0 && (
                <div class="mt-5">
                  <h4 class="text-label text-muted">
                    {exploringLabels.reading}
                  </h4>
                  <ul class="mt-2 divide-y divide-line" role="list">
                    {thread.readings.map((reading) => (
                      <li class="py-2">
                        <ArrowLink href={reading.url} title={reading.title} />
                        <p class="text-label text-muted">
                          <HyphenSafeText
                            text={`${reading.authors}, ${reading.year}`}
                          />
                        </p>
                        <p class="mt-1 text-small text-muted">
                          <HyphenSafeText text={reading.note} />
                        </p>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
            {thread.directions && thread.directions.length > 0 && (
              <div class="mt-5 xl:mt-3 xl:border-l xl:border-line xl:pl-8">
                <h4 class="text-label text-muted">
                  {exploringLabels.directions}
                </h4>
                <ul class="mt-2 flex flex-wrap gap-2" role="list">
                  {thread.directions.map((direction) => (
                    <li class="rounded-md border border-hairline bg-raised px-3 py-1.5 text-small text-ink">
                      <HyphenSafeText text={direction} />
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {thread.id === figureThread && (
              <div class="mt-6 hidden border-t border-line pt-5 sm:block lg:mt-3 lg:border-t-0 lg:pt-0">
                <HierarchyDiagram />
              </div>
            )}
          </div>
        </article>
      </li>
    ))}
  </ol>
</Section>
