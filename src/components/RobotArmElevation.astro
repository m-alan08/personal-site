---
import FigureCorners from "./FigureCorners.astro";

const shoulder = { x: 90, y: 274 };
const elbow = { x: 124, y: 96 };
const wrist = { x: 192, y: 184 };

const linkBetween = (from: typeof shoulder, to: typeof shoulder) => ({
  transform: `translate(${from.x} ${from.y}) rotate(${(Math.atan2(to.y - from.y, to.x - from.x) * 180) / Math.PI})`,
  length: Math.hypot(to.x - from.x, to.y - from.y),
});

const upperArm = linkBetween(shoulder, elbow);
const forearm = linkBetween(elbow, wrist);
const joints = [
  { ...shoulder, size: 24, horn: 7 },
  { ...elbow, size: 22, horn: 6 },
  { ...wrist, size: 18, horn: 4.5 },
];
const crosshairReach = 20;
const hatchMarks = Array.from({ length: 16 }, (_, index) => 20 + index * 13);
---

<svg
  viewBox="0 0 240 360"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="h-auto w-full max-w-[15rem]"
>
  <FigureCorners width={240} height={360} />
  <g class="stroke-line" stroke-width="1">
    <path d="M14 312 H226"></path>
    {hatchMarks.map((x) => (
      <path d={`M${x} 312 l-6 7`}></path>
    ))}
    {joints.map((joint) => (
      <path
        d={`M${joint.x - crosshairReach} ${joint.y} H${joint.x + crosshairReach} M${joint.x} ${joint.y - crosshairReach} V${joint.y + crosshairReach}`}
      ></path>
    ))}
    <g stroke-dasharray="2 4">
      <path d="M52.4 260.3 A40 40 0 0 1 127.6 260.3"></path>
      <path d="M152.2 106.3 A30 30 0 0 1 109 122"></path>
      <path d="M36 96 H100"></path>
    </g>
    <path d="M28 96 V312 M24 96 H32 M24 312 H32 M25 99 L31 93 M25 315 L31 309"></path>
  </g>

  <g class="stroke-muted/70 fill-canvas" stroke-width="1.25">
    <rect x="52" y="300" width="76" height="12" rx="2"></rect>
    <path d="M66 300 L72 286 H108 L114 300"></path>
    <g transform={upperArm.transform}>
      <rect
        x="-11"
        y="-9"
        width={upperArm.length + 22}
        height="18"
        rx="9"
      ></rect>
      <rect
        x="20"
        y="-2.5"
        width={upperArm.length - 40}
        height="5"
        rx="2.5"
        class="stroke-line"
      ></rect>
    </g>
    <g transform={forearm.transform}>
      <rect
        x="-10"
        y="-8"
        width={forearm.length + 20}
        height="16"
        rx="8"
      ></rect>
      <rect
        x="18"
        y="-2"
        width={forearm.length - 36}
        height="4"
        rx="2"
        class="stroke-line"
      ></rect>
    </g>
    <rect x="185" y="184" width="14" height="30" rx="3"></rect>
    <rect x="180" y="210" width="24" height="8" rx="2"></rect>
    <path d="M185 218 V238 l3 4 M199 218 V236 l-3 4"></path>
    {joints.map((joint) => (
      <g>
        <rect
          x={joint.x - joint.size / 2}
          y={joint.y - joint.size / 2}
          width={joint.size}
          height={joint.size}
          rx="3"
        ></rect>
        <circle cx={joint.x} cy={joint.y} r={joint.horn}></circle>
      </g>
    ))}
  </g>

  <g class="fill-muted/70">
    <circle cx="60" cy="306" r="1.5"></circle>
    <circle cx="120" cy="306" r="1.5"></circle>
    {joints.map((joint) => (
      <circle cx={joint.x} cy={joint.y} r="1.75"></circle>
    ))}
  </g>

  <g class="stroke-accent" stroke-width="1.25">
    <path d="M192 248 V270" stroke-dasharray="2 4" class="opacity-60"></path>
    <rect x="186" y="277" width="12" height="7" rx="1"></rect>
    <rect x="184" y="284" width="16" height="28" rx="2.5"></rect>
    <path d="M184 295 H200" class="opacity-60"></path>
  </g>
</svg>
