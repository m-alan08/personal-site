---
import ArrowLink from "./ArrowLink.astro";
import HyphenSafeText from "./HyphenSafeText.astro";
interface Entry {
  title: string;
  meta?: string;
  summary: string;
  href?: string;
  internal?: boolean;
}
interface Props {
  entries: Entry[];
}
const { entries } = Astro.props;
---

<ul class="divide-y divide-line" role="list">
  {entries.map((entry) => (
    <li class="py-6 first:pt-0 last:pb-0">
      <div>
        <h3 class="font-medium leading-snug tracking-tight">
          {entry.href && entry.internal ? (
            <ArrowLink href={entry.href} title={entry.title} />
          ) : entry.href ? (
            <a
              href={entry.href}
              class="-mx-3 -my-3 inline-flex min-h-11 items-center px-3 py-3 underline focus-visible:outline-offset-[-10px]! decoration-accent decoration-1 underline-offset-[5px] transition-colors duration-150 hover:decoration-ink motion-reduce:transition-none"
            >
              <span>
                <HyphenSafeText text={entry.title} />
              </span>
            </a>
          ) : (
            <span class="inline-flex min-h-11 items-center -my-3 py-3">
              <span>
                <HyphenSafeText text={entry.title} />
              </span>
            </span>
          )}
        </h3>
        {entry.meta && (
          <p class="mt-1.5 text-sm tabular-nums text-muted">{entry.meta}</p>
        )}
      </div>
      <p class="mt-2 max-w-reading text-muted">{entry.summary}</p>
    </li>
  ))}
</ul>
