---
import { Image } from "astro:assets";
import type { ProjectCardImage } from "../data/projects";
interface Props {
  image: ProjectCardImage;
  sizes: string;
  eager?: boolean;
}
const { image, sizes, eager = false } = Astro.props;
---

<figure class="m-0 min-w-0">
  <div class="relative overflow-hidden rounded-lg border border-hairline bg-raised">
    <Image
      src={image.src}
      alt={image.alt}
      widths={[320, 640, 960, 1280]}
      sizes={sizes}
      format="webp"
      quality={78}
      loading={eager ? "eager" : "lazy"}
      class="block aspect-[16/10] w-full object-cover"
    />
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-canvas/10 shadow-[inset_0_0_28px_rgb(0_0_0/0.4)]"
    ></span>
  </div>
  <figcaption class="mt-2.5 font-mono text-label text-muted">
    {image.caption}
  </figcaption>
</figure>
