---
import { Image } from "astro:assets";
import type { ProjectCardImage } from "../data/projects";
import ProjectMedia from "./ProjectMedia.astro";
interface Props {
  image: ProjectCardImage;
  sizes: string;
  eager?: boolean;
}
const { image, sizes, eager = false } = Astro.props;
const bleed = image.frame === "bleed";
---

<ProjectMedia caption={image.caption}>
  <div
    class:list={[
      "absolute overflow-hidden",
      bleed
        ? "inset-0"
        : "inset-3 rounded-md border border-hairline sm:inset-4",
    ]}
  >
    <Image
      src={image.src}
      alt={image.alt}
      widths={[320, 640, 960, 1280]}
      sizes={sizes}
      format="webp"
      quality={bleed ? 82 : 78}
      loading={eager ? "eager" : "lazy"}
      class:list={[
        "block size-full object-cover",
        bleed ? "object-center" : "object-top",
      ]}
    />
  </div>
</ProjectMedia>
