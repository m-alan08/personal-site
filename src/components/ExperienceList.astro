---
import type { Experience } from "../content/profile";
import HyphenSafeText from "./HyphenSafeText.astro";
import TextLink from "./TextLink.astro";
interface Props {
  entries: Experience[];
}
const { entries } = Astro.props;
const periodParts = (period: string) => {
  const [start, end] = period.split(" to ");
  return { start, end, current: end === "present" };
};
---

<ol class="divide-y divide-line" role="list">
  {entries.map((entry) => {
    const period = periodParts(entry.period);
    return (
      <li class="grid gap-y-3 py-8 first:pt-0 last:pb-0 md:grid-cols-[10rem_minmax(0,1fr)] md:gap-x-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-x-16">
        <p class="text-sm leading-relaxed tabular-nums text-muted md:pt-1.5">
          <span class="text-ink">{period.start}</span>
          {period.end && (
            <span class="md:block">
              {" to "}
              <span class:list={[period.current && "text-ink"]}>
                {period.end}
              </span>
            </span>
          )}
        </p>
        <div class="min-w-0">
          <h3 class="font-display text-xl leading-snug tracking-tight">
            {entry.href ? (
              <TextLink href={entry.href}>
                <HyphenSafeText text={entry.organization} />
              </TextLink>
            ) : (
              <span class="inline-flex min-h-11 items-center">
                <HyphenSafeText text={entry.organization} />
              </span>
            )}
          </h3>
          <p class="text-sm text-ink/80">
            <HyphenSafeText text={entry.role} />
          </p>
          <p class="mt-3 max-w-reading text-muted">
            <HyphenSafeText text={entry.summary} />
          </p>
          {entry.metrics && (
            <ul class="mt-4 flex flex-wrap gap-1.5" role="list">
              {entry.metrics.map((metric) => (
                <li class="rounded-full border border-hairline px-3 py-1 text-small tabular-nums text-muted">
                  <HyphenSafeText text={metric} />
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    );
  })}
</ol>
