---
import type { Experience } from "../content/profile";
import { labels } from "../content/site";
import HyphenSafeText from "./HyphenSafeText.astro";
import TextLink from "./TextLink.astro";
interface Props {
  entries: Experience[];
}
const { entries } = Astro.props;
const metricNumber = /(\d[\d.,]*(?:%|x|\+)?)/;
const periodParts = (period: string) => {
  const [start, end] = period.split(" to ");
  return { start, end, current: end === "present" };
};
---

<ol class="divide-y divide-line" role="list">
  {entries.map((entry) => {
    const period = periodParts(entry.period);
    const metrics = entry.metrics ?? [];
    return (
      <li class="grid gap-y-3 py-8 first:pt-0 last:pb-0 md:grid-cols-[10rem_minmax(0,1fr)] md:gap-x-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-x-16 print:grid-cols-[9rem_minmax(0,1fr)] print:gap-x-6 print:py-4">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 md:flex-col md:items-start md:pt-1.5">
          <p class="font-mono text-label uppercase tabular-nums text-muted">
            <span>{period.start}</span>
            {period.end && <span class="md:block">{` to ${period.end}`}</span>}
          </p>
          {period.current && (
            <span class="rounded-sm border border-hairline px-1.5 py-0.5 font-mono text-label uppercase text-ink print:border-line">
              {labels.current}
            </span>
          )}
        </div>
        <div class="min-w-0">
          <h3 class="text-h3">
            {entry.href ? (
              <TextLink href={entry.href}>
                <span>
                  <HyphenSafeText text={entry.organization} />
                </span>
              </TextLink>
            ) : (
              <span class="inline-flex min-h-11 items-center print:inline print:min-h-0">
                <span>
                  <HyphenSafeText text={entry.organization} />
                </span>
              </span>
            )}
          </h3>
          <p class="text-small text-ink/80">
            <HyphenSafeText text={entry.role} />
          </p>
          <p class="mt-3 max-w-reading text-muted">
            <HyphenSafeText text={entry.summary} />
          </p>
          {metrics.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2" role="list">
              {metrics.map((metric) => (
                <li class="rounded-md border border-hairline bg-surface px-2.5 py-1 text-small text-muted print:border-line">
                  {metric
                    .split(metricNumber)
                    .map((part, index) =>
                      index % 2 === 1 ? (
                        <span class="font-mono font-medium tabular-nums text-ink">
                          {part}
                        </span>
                      ) : (
                        <HyphenSafeText text={part} />
                      ),
                    )}
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    );
  })}
</ol>
