---
import type { Project } from "../data/projects";
import { projectLink } from "../data/links";
import { headlineResults, projectCardLabels } from "../content/projectCards";
import HyphenSafeText from "./HyphenSafeText.astro";
import ProjectBadges from "./ProjectBadges.astro";
import ProjectChart from "./ProjectChart.astro";
import ProjectFrame from "./ProjectFrame.astro";
import ProjectLinks from "./ProjectLinks.astro";
import ProjectTags from "./ProjectTags.astro";
interface Props {
  project: Project;
  eager?: boolean;
  accent?: boolean;
}
const { project, eager = false, accent = false } = Astro.props;
const headline = headlineResults[project.slug];
---

<article
  class:list={[
    "relative grid content-start gap-6 rounded-xl border border-hairline bg-surface p-5 transition duration-200 ease-out hover:border-control motion-safe:hover:-translate-y-1 motion-safe:hover:shadow-[0_18px_50px_-16px_rgb(0_0_0/0.7)] motion-reduce:transition-none sm:p-6",
    "has-[[data-card-link]:focus-visible]:outline-2 has-[[data-card-link]:focus-visible]:outline-offset-4 has-[[data-card-link]:focus-visible]:outline-ink",
    "lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-start lg:gap-10 lg:p-8",
  ]}
>
  {project.cardChart ? (
    <ProjectChart chart={project.cardChart} />
  ) : (
    project.cardImage && (
      <ProjectFrame
        image={project.cardImage}
        eager={eager}
        sizes="(min-width: 1248px) 40rem, (min-width: 1024px) 52vw, 100vw"
      />
    )
  )}
  <div class="grid min-w-0 content-start gap-4">
    <h3 class="m-0 text-h2 text-ink">
      <a
        href={projectLink(project.slug)}
        data-card-link
        class="flex min-h-11 items-center after:absolute after:inset-0 after:rounded-xl focus-visible:outline-transparent!"
      >
        <span>
          <HyphenSafeText text={project.title} />
        </span>
      </a>
    </h3>
    <p class="m-0 max-w-reading text-muted">
      <HyphenSafeText text={project.summary} />
    </p>
    {headline && (
      <p class="m-0 border-l border-control pl-4">
        <span class="sr-only">{projectCardLabels.result}: </span>
        <span
          class:list={[
            "block text-h2 tabular-nums",
            accent ? "text-accent" : "text-ink",
          ]}
        >
          {headline.value}
        </span>
        <span class="block text-small text-muted">
          <HyphenSafeText text={headline.detail} />
        </span>
      </p>
    )}
    <ProjectBadges project={project} />
    <ProjectTags tags={project.technology} />
    <ProjectLinks project={project} />
  </div>
</article>
