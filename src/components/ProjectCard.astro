---
import type { Project } from "../data/projects";
import { labels, caseStudy } from "../content/site";
import { projectLink } from "../data/links";
import { externalLinks } from "../data/projectLinks";
import TextLink from "./TextLink.astro";
import ProjectImage from "./ProjectImage.astro";
interface Props {
  project: Project;
}
const { project } = Astro.props;
const meta = [project.ownership, project.event?.name, project.status].filter(
  Boolean,
);
const external = externalLinks(project);
---

<article class="flex flex-col gap-6 py-10 first:pt-0 last:pb-0">
  <div class="min-w-0">
    <h3 class="text-lg font-medium leading-snug tracking-tight">
      <a
        href={projectLink(project.slug)}
        class="inline-flex min-h-11 items-center transition-colors duration-150 hover:text-accent motion-reduce:transition-none"
      >
        {project.title}
      </a>
    </h3>
    <p class="text-sm text-muted">{meta.join(" · ")}</p>
    <p class="mt-3 max-w-reading">{project.summary}</p>
    {project.technology.length > 0 && (
      <p class="mt-3 max-w-reading text-sm text-muted">
        <span class="sr-only">{labels.technology}: </span>
        {project.technology.join(" · ")}
      </p>
    )}
    <ul class="mt-2 flex flex-wrap gap-x-6 text-sm" role="list">
      <li>
        <TextLink href={projectLink(project.slug)}>
          {caseStudy.read}
          <span class="sr-only">: {project.title}</span>
        </TextLink>
      </li>
      {external.map((link) => (
        <li>
          <TextLink href={link.href}>
            {link.label}
            <span class="sr-only">: {project.title}</span>
          </TextLink>
        </li>
      ))}
    </ul>
  </div>
  {project.image && (
    <div class="order-first">
      <ProjectImage
        image={project.image}
        sizes="(min-width: 768px) 40rem, 100vw"
      />
    </div>
  )}
</article>
