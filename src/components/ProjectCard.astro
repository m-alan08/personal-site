---
import type { Project } from "../data/projects";
import { labels, caseStudy } from "../content/site";
import { projectLink } from "../data/links";
import { externalLinks } from "../data/projectLinks";
import TextLink from "./TextLink.astro";
import ProjectImage from "./ProjectImage.astro";
import ArrowIcon from "./ArrowIcon.astro";
interface Props {
  project: Project;
}
const { project } = Astro.props;
const meta = [project.ownership, project.event?.name, project.status].filter(
  Boolean,
);
const external = externalLinks(project);
const images = [project.image, ...(project.gallery ?? [])]
  .filter((image) => image !== undefined)
  .slice(0, 2);
---

<article
  class:list={[
    "grid gap-5 py-8 first:pt-0 last:pb-0",
    images.length > 0 && "sm:grid-cols-[minmax(0,1fr)_16rem] sm:gap-8",
  ]}
>
  <div class="min-w-0">
    <h3 class="text-lg font-medium leading-snug tracking-tight">
      <a
        href={projectLink(project.slug)}
        class="group inline-flex min-h-11 items-center transition-colors duration-150 hover:text-accent motion-reduce:transition-none"
      >
        <span>
          {project.title}
          <ArrowIcon class="ml-1.5 group-hover:translate-x-1 group-focus-visible:translate-x-1" />
        </span>
      </a>
    </h3>
    <p class="text-sm text-muted">{meta.join(" · ")}</p>
    <p class="mt-3 max-w-reading">{project.summary}</p>
    {project.technology.length > 0 && (
      <p class="mt-3 max-w-reading text-sm text-muted">
        <span class="sr-only">{labels.technology}: </span>
        {project.technology.join(" · ")}
      </p>
    )}
    <ul class="mt-2 flex flex-wrap gap-x-6 text-sm" role="list">
      <li>
        <TextLink href={projectLink(project.slug)}>
          {caseStudy.read}
          <span class="sr-only">: {project.title}</span>
        </TextLink>
      </li>
      {external.map((link) => (
        <li>
          <TextLink href={link.href}>
            {link.label}
            <span class="sr-only">: {project.title}</span>
          </TextLink>
        </li>
      ))}
    </ul>
  </div>
  {images.length > 0 && (
    <div class="grid grid-cols-2 gap-3 self-start sm:order-last sm:grid-cols-1">
      {images.map((image) => (
        <ProjectImage image={image} sizes="(min-width: 640px) 16rem, 50vw" />
      ))}
    </div>
  )}
</article>
