---
import type { Project } from "../data/projects";
import { labels, caseStudy } from "../content/site";
import { projectLink } from "../data/links";
import { externalLinks } from "../data/projectLinks";
import TextLink from "./TextLink.astro";
import ProjectImage from "./ProjectImage.astro";
import ArrowLink from "./ArrowLink.astro";
import HyphenSafeText from "./HyphenSafeText.astro";
interface Props {
  project: Project;
  number: number;
}
const { project, number } = Astro.props;
const meta = [project.ownership, project.event?.name, project.status].filter(
  Boolean,
);
const external = externalLinks(project);
const image = project.image ?? project.gallery?.[0];
---

<article
  class:list={[
    "grid gap-6 py-10 first:pt-0 last:pb-0 sm:py-12",
    "lg:grid-cols-[minmax(0,9fr)_minmax(0,11fr)] lg:items-center lg:gap-12 xl:gap-16",
  ]}
>
  <div class="min-w-0">
    <p
      aria-hidden="true"
      class="text-xs tabular-nums tracking-[0.2em] text-accent"
    >
      {String(number).padStart(2, "0")}
    </p>
    <h3 class="mt-3 text-xl font-medium leading-snug tracking-tight">
      <ArrowLink href={projectLink(project.slug)} title={project.title} />
    </h3>
    <p class="mt-1.5 text-sm text-muted">
      <HyphenSafeText text={meta.join(" · ")} />
    </p>
    <p class="mt-4 max-w-reading">
      <HyphenSafeText text={project.summary} />
    </p>
    {project.technology.length > 0 && (
      <p class="mt-3 max-w-reading text-sm text-muted">
        <span class="sr-only">{labels.technology}: </span>
        <HyphenSafeText text={project.technology.join(" · ")} />
      </p>
    )}
    <ul class="mt-2 flex flex-wrap gap-x-6 text-sm" role="list">
      <li>
        <TextLink href={projectLink(project.slug)}>
          {caseStudy.read}
          <span class="sr-only">: {project.title}</span>
        </TextLink>
      </li>
      {external.map((link) => (
        <li>
          <TextLink href={link.href}>
            {link.label}
            <span class="sr-only">: {project.title}</span>
          </TextLink>
        </li>
      ))}
    </ul>
  </div>
  {image && (
    <a
      href={projectLink(project.slug)}
      tabindex="-1"
      aria-hidden="true"
      class="group block"
    >
      <ProjectImage
        image={image}
        sizes="(min-width: 1280px) 40rem, (min-width: 1024px) 52vw, 100vw"
        class="transition-colors duration-150 group-hover:border-muted motion-reduce:transition-none"
      />
    </a>
  )}
</article>
