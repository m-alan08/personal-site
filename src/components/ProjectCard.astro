---
import type { Project } from "../data/projects";
import { labels, caseStudy } from "../content/site";
import { projectLink } from "../data/links";
import TextLink from "./TextLink.astro";
interface Props {
  project: Project;
  heading?: "h2" | "h3";
}
const { project, heading: Heading = "h2" } = Astro.props;
---

<article
  data-project-category={project.category}
  class="surface flex flex-col gap-6 rounded-xl p-6 sm:p-8"
>
  <div>
    <p class="font-medium text-accent">{project.ownership}</p>
    <Heading class="mt-2 text-2xl font-semibold leading-snug tracking-tight">
      <a
        href={projectLink(project.slug)}
        class="inline-block min-h-11 py-1 transition-colors duration-150 hover:text-accent motion-reduce:transition-none"
      >
        {project.title}
      </a>
    </Heading>
    <p class="mt-3 text-muted">{project.status}</p>
  </div>
  <div>
    <p class="text-xl font-medium leading-snug">{project.question}</p>
    <p class="mt-4 max-w-reading">{project.summary}</p>
    <p class="mt-3 max-w-reading text-muted">{project.scope}</p>
    {project.technology.length > 0 && (
      <ul
        class="mt-5 flex flex-wrap gap-2"
        aria-label={labels.technology}
        role="list"
      >
        {project.technology.map((tool) => (
          <li class="rounded-sm bg-surface px-3 py-1 text-base">{tool}</li>
        ))}
      </ul>
    )}
    <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
      <TextLink href={projectLink(project.slug)}>
        {caseStudy.read}
        <span class="sr-only">: {project.title}</span>
      </TextLink>
      {project.repository ? (
        <TextLink href={project.repository}>{labels.repository}</TextLink>
      ) : (
        <p class="text-muted">{labels.repositoryMissing}</p>
      )}
    </div>
  </div>
</article>
