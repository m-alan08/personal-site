---
import { figures } from "../content/figures";

const notes = figures.notes;
const spacing = 50;
const entries = notes.entries.map((entry, index) => ({
  ...entry,
  y: 46 + index * spacing,
}));
const height = 46 + notes.entries.length * spacing - 14;
---

<svg
  viewBox={`0 0 240 ${height}`}
  fill="none"
  class="h-auto w-full max-w-[15rem]"
>
  <path d={`M2 6 V${height - 6}`} class="stroke-line" stroke-width="1"></path>
  <text x="16" y="14" font-size="9" letter-spacing="2" class="fill-muted">
    {notes.heading}
  </text>
  {entries.map((entry) => (
    <>
      <path
        d={`M0 ${entry.y - 4} H5`}
        class="stroke-accent"
        stroke-width="1.25"
      ></path>
      <text
        x="16"
        y={entry.y}
        font-size="14"
        class="fill-ink font-display italic"
      >
        {entry.before}
        <tspan class="fill-accent">{entry.accent}</tspan>
        {entry.after}
      </text>
      <text x="16" y={entry.y + 16} font-size="10" class="fill-muted">
        {entry.note}
      </text>
    </>
  ))}
</svg>
