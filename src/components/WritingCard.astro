---
import ArrowIcon from "./ArrowIcon.astro";
import HyphenSafeText from "./HyphenSafeText.astro";
import { labels } from "../content/site";
interface Props {
  title: string;
  href: string;
  note?: string;
  source?: string;
  date?: string;
}
const { title, href, note, source, date } = Astro.props;
const platforms: Record<string, string> = {
  "x.com": labels.x,
  "github.com": labels.github,
};
const platform =
  source ?? platforms[new URL(href).hostname.replace(/^www\./, "")] ?? "";
---

<li>
  <a
    href={href}
    class="group grid min-h-11 gap-x-6 gap-y-1 py-4 sm:grid-cols-[5.5rem_minmax(0,1fr)_auto] sm:items-baseline"
  >
    <span class="text-label text-muted">{platform}</span>
    <span class="min-w-0">
      <span class="font-medium text-ink transition-colors duration-150 group-hover:text-accent group-focus-visible:text-accent motion-reduce:transition-none">
        <HyphenSafeText text={title} />
      </span>
      {note && (
        <span class="mt-1 block text-small text-muted">
          <HyphenSafeText text={note} />
        </span>
      )}
    </span>
    <span class="flex items-center gap-4 self-center">
      {date && <span class="text-label tabular-nums text-muted">{date}</span>}
      <ArrowIcon class="group-hover:translate-x-1 group-focus-visible:translate-x-1" />
    </span>
  </a>
</li>
