---
import ArrowIcon from "./ArrowIcon.astro";
import HyphenSafeText from "./HyphenSafeText.astro";
import { labels } from "../content/site";
interface Props {
  title: string;
  href: string;
  note: string;
}
const { title, href, note } = Astro.props;
const platforms: Record<string, string> = {
  "x.com": labels.x,
  "github.com": labels.github,
};
const platform = platforms[new URL(href).hostname.replace(/^www\./, "")];
---

<a
  href={href}
  class="group flex h-full flex-col rounded-xl border border-hairline bg-surface p-5 transition duration-200 ease-out hover:border-control motion-safe:hover:-translate-y-1 motion-safe:hover:shadow-[0_18px_50px_-16px_rgb(0_0_0/0.7)] motion-reduce:transition-none"
>
  <span class="flex items-center justify-between gap-4">
    {platform && <span class="text-label text-muted">{platform}</span>}
    <ArrowIcon class="ml-auto group-hover:translate-x-1 group-focus-visible:translate-x-1" />
  </span>
  <span class="mt-3 font-semibold leading-snug text-ink transition-colors duration-150 group-hover:text-accent motion-reduce:transition-none">
    <HyphenSafeText text={title} />
  </span>
  <span class="mt-1.5 text-small text-muted">
    <HyphenSafeText text={note} />
  </span>
</a>
