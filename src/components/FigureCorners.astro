---
interface Props {
  width: number;
  height: number;
}
const { width, height } = Astro.props;
const inset = 8;
const reach = 12;
const right = width - inset;
const bottom = height - inset;
const marks = [
  `M${inset} ${inset + reach} V${inset} H${inset + reach}`,
  `M${right - reach} ${inset} H${right} V${inset + reach}`,
  `M${inset} ${bottom - reach} V${bottom} H${inset + reach}`,
  `M${right - reach} ${bottom} H${right} V${bottom - reach}`,
];
---

<g class="stroke-line" stroke-width="1">
  {marks.map((mark) => (
    <path d={mark}></path>
  ))}
</g>
