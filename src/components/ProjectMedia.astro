---
interface Props {
  caption: string;
}
const { caption } = Astro.props;
---

<figure class="m-0 min-w-0">
  <div class="relative aspect-[4/3] overflow-hidden rounded-lg border border-hairline bg-raised sm:aspect-[16/10]">
    <slot />
  </div>
  <figcaption class="mt-3 font-mono text-label text-muted">
    {caption}
  </figcaption>
</figure>
