---
import { caseStudyLabels } from "../content/caseStudyPage";
interface Props {
  sections: { id: string; title: string }[];
}
const { sections } = Astro.props;
---

<nav
  aria-label={caseStudyLabels.onThisPage}
  data-case-study-rail
  class="hidden lg:sticky lg:top-24 lg:block lg:self-start"
>
  <p aria-hidden="true" class="text-eyebrow uppercase text-muted">
    {caseStudyLabels.onThisPage}
  </p>
  <ol role="list" class="mt-3 border-l border-line">
    {sections.map((section, index) => (
      <li>
        <a
          href={`#${section.id}`}
          class="-ml-px flex min-h-11 items-baseline gap-3 border-l border-transparent pl-4 text-small text-muted transition-colors duration-150 hover:text-ink aria-[current=true]:border-accent aria-[current=true]:text-accent motion-reduce:transition-none"
        >
          <span class="text-label tabular-nums opacity-60">
            {String(index + 1).padStart(2, "0")}
          </span>
          {section.title}
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-case-study-rail] a"),
  ];
  const sections = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((section): section is HTMLElement => section !== null);
  const isOnScreen = (section: HTMLElement) => {
    const { top, bottom } = section.getBoundingClientRect();
    return top < innerHeight && bottom > 0;
  };
  const update = () => {
    const passed = sections.filter(
      (section) => section.getBoundingClientRect().top <= innerHeight * 0.25,
    );
    let active = passed.at(-1) ?? sections[0];
    const root = document.documentElement;
    if (innerHeight + scrollY >= root.scrollHeight - 4) {
      const linked = sections.find(
        (section) => `#${section.id}` === location.hash,
      );
      active =
        linked && isOnScreen(linked)
          ? linked
          : (sections.filter(isOnScreen).at(-1) ?? active);
    }
    for (const link of links) {
      if (link.hash === `#${active?.id}`)
        link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
  };
  const watch = (
    targets: (Element | null)[],
    options: IntersectionObserverInit,
  ) => {
    const observer = new IntersectionObserver(update, options);
    for (const target of targets) if (target) observer.observe(target);
  };
  watch(sections, { rootMargin: "0px 0px -75% 0px" });
  watch([document.querySelector("footer")], { threshold: 1 });
  addEventListener("hashchange", update);
  addEventListener("scrollend", update);
</script>
