---
import { Image } from "astro:assets";
import type { ProjectImage } from "../data/projects";
interface Props {
  image: ProjectImage;
  sizes: string;
  eager?: boolean;
}
const { image, sizes, eager = false } = Astro.props;
---

<Image
  src={image.src}
  alt={image.alt}
  widths={[320, 640, 960, 1280]}
  sizes={sizes}
  format="webp"
  quality={78}
  loading={eager ? "eager" : "lazy"}
  class:list={[
    "aspect-video w-full rounded-lg border border-line bg-surface",
    image.fit === "cover" ? "object-cover object-top" : "object-contain p-2",
  ]}
/>
