---
import { Image } from "astro:assets";
import type { ProjectImage } from "../data/projects";
interface Props {
  image: ProjectImage;
  sizes: string;
  eager?: boolean;
  natural?: boolean;
  tile?: boolean;
}
const {
  image,
  sizes,
  eager = false,
  natural = false,
  tile = false,
} = Astro.props;
---

<Image
  src={image.src}
  alt={image.alt}
  widths={[320, 640, 960, 1280]}
  sizes={sizes}
  format="webp"
  quality={78}
  loading={eager ? "eager" : "lazy"}
  class:list={[
    "w-full rounded-lg border border-line bg-surface",
    natural
      ? "h-auto"
      : [
          tile ? "aspect-[4/5]" : "aspect-video",
          image.fit === "cover"
            ? "object-cover object-top"
            : "object-contain p-2",
        ],
  ]}
/>
