---
import { experience } from "../content/profile";
import { figures } from "../content/figures";

const monthNames = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
const monthIndex = (text: string) => {
  const [month, year] = text.split(" ");
  return Number(year) * 12 + monthNames.indexOf(month);
};
const today = new Date();
const now = today.getFullYear() * 12 + today.getMonth();
const spans = experience.flatMap((entry) => {
  const [start, end] = entry.period.split(" to ");
  if (!end) return [];
  const current = end === "present";
  return [
    {
      label: entry.organization,
      period: entry.period,
      start: monthIndex(start),
      end: (current ? now : monthIndex(end)) + 1,
      current,
    },
  ];
});
const first = Math.min(...spans.map((span) => span.start));
const last = Math.max(...spans.map((span) => span.end));
const width = 1000;
const barLeft = 240;
const right = width - 4;
const x = (month: number) =>
  barLeft + ((month - first) / (last - first)) * (right - barLeft);
const rowHeight = 30;
const top = 6;
const rows = spans.map((span, index) => ({
  ...span,
  y: top + index * rowHeight,
  from: x(span.start),
  to: x(span.end),
}));
const axisY = top + rows.length * rowHeight + 2;
const firstYear = Math.floor(first / 12);
const years = Array.from(
  { length: Math.floor((last - 1) / 12) - firstYear + 1 },
  (_, index) => {
    const year = firstYear + index;
    return { year, x: x(Math.max(year * 12, first)) };
  },
);
const nowX = x(now + 1);
---

<svg viewBox={`0 0 ${width} ${axisY + 24}`} fill="none" class="h-auto w-full">
  <g class="stroke-line" stroke-width="1">
    <path d={`M0 ${axisY} H${right}`}></path>
    {rows.map((row) => (
      <path
        d={`M${barLeft} ${row.y + 15} H${right}`}
        stroke-dasharray="1 5"
      ></path>
    ))}
    {years.map((tick) => (
      <path d={`M${tick.x} ${top} V${axisY + 6}`} stroke-dasharray="2 4"></path>
    ))}
  </g>
  <path
    d={`M${nowX} ${top} V${axisY + 6}`}
    class="stroke-accent"
    stroke-width="1.5"
    stroke-dasharray="2 3"
  ></path>
  {rows.map((row) => (
    <>
      <text x="0" y={row.y + 19} font-size="13" class="fill-ink">
        {row.label}
      </text>
      <rect
        x={row.from}
        y={row.y + 11}
        width={Math.max(row.to - row.from, 6)}
        height="8"
        rx="4"
        class={row.current ? "fill-ink/70" : "fill-muted/40"}
      ></rect>
    </>
  ))}
  <g font-size="12" class="fill-muted tabular-nums">
    {years.map((tick) => (
      <text x={tick.x + 4} y={axisY + 18}>
        {tick.year}
      </text>
    ))}
  </g>
  <text
    x={nowX}
    y={axisY + 18}
    font-size="12"
    text-anchor="end"
    class="fill-accent"
  >
    {figures.timeline.now}
  </text>
</svg>
