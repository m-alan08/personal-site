---
import { labels } from "../content/site";
import { localLinks } from "../data/links";
import { sections, sectionLink } from "../data/sections";
const isHome = Astro.url.pathname === localLinks.home;
import { containerWidth } from "../data/layout";
interface Props {
  wide: boolean;
}
const { wide } = Astro.props;
---

<header class="w-full border-b border-transparent sm:sticky sm:top-0 sm:z-40 sm:border-line/60 sm:bg-chrome/85 sm:backdrop-blur-md">
  <div
    class:list={[
      "mx-auto flex w-full flex-wrap items-center justify-start gap-x-8 gap-y-1 px-6 pt-6 sm:justify-end sm:px-10 sm:py-2",
      containerWidth(wide),
    ]}
  >
    <nav aria-label={labels.mainNavigation} class="-mx-2">
      <ul class="grid grid-cols-3 sm:flex sm:flex-wrap" role="list">
        {sections.map((section) => (
          <li>
            <a
              href={isHome ? `#${section.id}` : sectionLink(section.id)}
              class="inline-flex min-h-11 min-w-11 items-center px-2 text-sm sm:justify-center text-muted transition-colors duration-150 hover:text-accent motion-reduce:transition-none"
            >
              {section.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
