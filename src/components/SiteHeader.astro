---
import { site, labels } from "../content/site";
import { localLinks } from "../data/links";
import { sections, sectionLink } from "../data/sections";
const isHome = Astro.url.pathname === localLinks.home;
---

<header class="mx-auto w-full max-w-4xl px-6 pt-6 sm:px-10 sm:pt-8">
  <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-1">
    <a
      href={localLinks.home}
      class="inline-flex min-h-11 items-center font-medium tracking-tight text-ink"
      aria-current={isHome ? "page" : undefined}
    >
      {site.name}
    </a>
    <nav aria-label={labels.mainNavigation} class="-mx-2">
      <ul class="flex flex-wrap" role="list">
        {sections.map((section) => (
          <li>
            <a
              href={isHome ? `#${section.id}` : sectionLink(section.id)}
              class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 text-sm text-muted transition-colors duration-150 hover:text-ink motion-reduce:transition-none"
            >
              {section.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
