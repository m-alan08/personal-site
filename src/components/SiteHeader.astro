---
import { labels, site } from "../content/site";
import { localLinks } from "../data/links";
import { sections, sectionLink } from "../data/sections";
import ArrowIcon from "./ArrowIcon.astro";
import { containerWidth } from "../data/layout";
interface Props {
  wide: boolean;
}
const { wide } = Astro.props;
const isHome = Astro.url.pathname === localLinks.home;
const linkClass =
  "inline-flex min-h-11 min-w-11 items-center px-2 text-sm text-muted decoration-accent decoration-2 underline-offset-8 transition-colors duration-150 hover:text-accent motion-reduce:transition-none aria-[current]:text-accent aria-[current]:underline";
---

<header
  data-header
  class="w-full border-b border-transparent transition-colors duration-300 sm:sticky sm:top-0 sm:z-40 sm:border-line/60 sm:bg-canvas/80 sm:backdrop-blur-md"
>
  <div
    class:list={[
      "mx-auto flex w-full flex-wrap items-center justify-between gap-x-6 px-6 py-3 sm:px-10",
      containerWidth(wide),
    ]}
  >
    <a
      href={localLinks.home}
      class="group inline-flex min-h-11 items-center gap-2.5 text-ink transition-colors duration-150 hover:text-accent motion-reduce:transition-none"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 32 32"
        class="size-6 shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="3.5"
        stroke-linejoin="round"
      >
        <path d="M3 26 9 6l6 20M5.5 19h7M19 26V6l5 11 5-11v20" />
      </svg>
      <span class="text-sm font-semibold tracking-tight">{site.name}</span>
    </a>
    <nav aria-label={labels.mainNavigation} class="flex items-center">
      <ul class="hidden sm:flex sm:items-center" role="list">
        {sections.map((section) => (
          <li>
            <a
              href={isHome ? `#${section.id}` : sectionLink(section.id)}
              data-section-link={section.id}
              class={linkClass}
            >
              {section.label}
            </a>
          </li>
        ))}
      </ul>
      <details class="group relative sm:hidden" data-nav-menu>
        <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-md px-2 text-sm text-muted transition-colors duration-150 hover:text-ink motion-reduce:transition-none [&::-webkit-details-marker]:hidden">
          {labels.menu}
          <svg
            aria-hidden="true"
            viewBox="0 0 16 16"
            class="size-3.5 transition-transform duration-150 group-open:rotate-180 motion-reduce:transition-none"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 6.5 8 10l4-3.5" />
          </svg>
        </summary>
        <ul
          role="list"
          class="absolute right-0 top-full z-50 mt-2 w-56 rounded-lg border border-line bg-canvas p-1.5 shadow-[0_18px_50px_-16px_rgb(0_0_0/0.8)]"
        >
          {sections.map((section, index) => (
            <li class:list={[index > 0 && "border-t border-hairline"]}>
              <a
                href={isHome ? `#${section.id}` : sectionLink(section.id)}
                data-section-link={section.id}
                class="group flex min-h-11 items-center justify-between rounded-md px-3 text-sm text-muted transition-colors duration-150 hover:bg-raised hover:text-ink motion-reduce:transition-none aria-[current]:text-accent"
              >
                <span class="flex items-baseline gap-3">
                  <span class="text-label tabular-nums text-muted/70">
                    {section.index}
                  </span>
                  {section.label}
                </span>
                <ArrowIcon class="opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100" />
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector("header[data-header]");
  if (header) {
    const syncHeader = () =>
      header.toggleAttribute("data-scrolled", window.scrollY > 8);
    syncHeader();
    addEventListener("scroll", syncHeader, { passive: true });
  }
  const links = document.querySelectorAll<HTMLAnchorElement>(
    "a[data-section-link]",
  );
  const bySection = new Map<HTMLElement, HTMLAnchorElement[]>();
  for (const link of links) {
    const section = document.getElementById(link.dataset.sectionLink ?? "");
    if (section) {
      const group = bySection.get(section) ?? [];
      group.push(link);
      bySection.set(section, group);
    }
  }
  if (bySection.size > 0) {
    const ordered = [...bySection.keys()];
    const first = ordered[0];
    const last = ordered[ordered.length - 1];
    let current: HTMLElement | null = null;
    const setCurrent = (section: HTMLElement | null) => {
      if (section === current) return;
      for (const group of bySection.values()) {
        for (const link of group) link.removeAttribute("aria-current");
      }
      if (section) {
        for (const link of bySection.get(section) ?? []) {
          link.setAttribute("aria-current", "location");
        }
      }
      current = section;
    };
    const visible = new Set<HTMLElement>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            visible.add(entry.target as HTMLElement);
          } else {
            visible.delete(entry.target as HTMLElement);
          }
        }
        const active = ordered.filter((section) => visible.has(section)).at(-1);
        if (active) {
          setCurrent(active);
        } else if (
          first.getBoundingClientRect().top >
          window.innerHeight * 0.35
        ) {
          setCurrent(null);
        } else if (
          window.scrollY + window.innerHeight >=
          document.documentElement.scrollHeight - 8
        ) {
          setCurrent(last);
        }
      },
      { rootMargin: "-30% 0px -62% 0px" },
    );
    for (const section of ordered) observer.observe(section);
  }
  const menu = document.querySelector<HTMLDetailsElement>(
    "details[data-nav-menu]",
  );
  if (menu) {
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) {
        menu.removeAttribute("open");
      }
    });
    document.addEventListener("pointerdown", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) {
        menu.removeAttribute("open");
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.removeAttribute("open");
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>
