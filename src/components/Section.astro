---
import type { SectionId } from "../data/sections";

interface Props {
  id: SectionId;
  title: string;
  stacked?: boolean;
}
const { id, title, stacked = false } = Astro.props;
const headingId = `${id}-heading`;
const pinned = !stacked && !Astro.slots.has("aside");
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[
    "grid gap-6 border-t border-line py-section-compact",
    stacked
      ? "md:gap-10"
      : "md:grid-cols-[10rem_minmax(0,1fr)] md:gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16",
  ]}
>
  <div class:list={[pinned && "md:sticky md:top-24 md:self-start"]}>
    <h2 id={headingId} class="text-h2 text-ink">
      {title}
    </h2>
    <slot name="aside" />
  </div>
  <div class="min-w-0">
    <slot />
  </div>
</section>
