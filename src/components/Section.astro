---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  [attribute: string]: unknown;
}
const { id, title, eyebrow, ...rest } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class="relative border-t border-line py-section-normal"
  {...rest}
>
  <div
    data-reveal
    class="flex flex-wrap items-end justify-between gap-x-10 gap-y-3"
  >
    <div>
      {eyebrow && (
        <p aria-hidden="true" class="text-eyebrow uppercase text-muted">
          {eyebrow}
        </p>
      )}
      <h2 id={headingId} class="mt-3 text-h2 text-ink">
        {title}
      </h2>
    </div>
    <slot name="aside" />
  </div>
  <div data-reveal style="--reveal-delay: 70ms" class="mt-8 md:mt-10">
    <slot />
  </div>
</section>
