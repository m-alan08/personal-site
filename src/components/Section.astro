---
import { sectionNumber, type SectionId } from "../data/sections";

interface Props {
  id: SectionId;
  title: string;
  stacked?: boolean;
}
const { id, title, stacked = false } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[
    "grid gap-6 border-t border-line py-14 sm:py-16",
    stacked
      ? "md:gap-10"
      : "md:grid-cols-[10rem_minmax(0,1fr)] md:gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16",
  ]}
>
  <div class:list={[!stacked && "md:sticky md:top-24 md:self-start"]}>
    <p
      aria-hidden="true"
      class="text-xs tabular-nums tracking-[0.2em] text-accent"
    >
      {sectionNumber(id)}
    </p>
    <h2
      id={headingId}
      class="mt-1.5 font-display text-2xl italic tracking-tight text-ink"
    >
      {title}
    </h2>
    <span aria-hidden="true" class="mt-4 block h-px w-8 bg-accent/70"></span>
    <slot name="aside" />
  </div>
  <div class="min-w-0">
    <slot />
  </div>
</section>
