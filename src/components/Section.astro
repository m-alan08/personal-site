---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class="grid gap-6 border-t border-line py-14 sm:py-16 md:grid-cols-[10rem_minmax(0,1fr)] md:gap-10"
>
  <h2
    id={headingId}
    class="font-display text-xl italic tracking-tight text-ink md:pt-0.5"
  >
    {title}
  </h2>
  <div class="min-w-0">
    <slot />
  </div>
</section>
