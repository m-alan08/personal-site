---
import Ticks from "./Ticks.astro";

interface Props {
  id: string;
  title: string;
  index?: string;
  eyebrow?: string;
  [attribute: string]: unknown;
}
const { id, title, index, eyebrow, ...rest } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[
    "relative border-t border-line py-section-normal",
    index && "atmo-rule",
  ]}
  {...rest}
>
  <div
    data-reveal
    class="flex flex-wrap items-end justify-between gap-x-10 gap-y-3"
  >
    <div>
      {(index || eyebrow) && (
        <p aria-hidden="true" class="flex items-center gap-2.5 text-muted">
          {index && (
            <>
              <Ticks class="h-2.5 text-control" />
              <span class="text-label tabular-nums">{index}</span>
            </>
          )}
          {eyebrow && <span class="text-eyebrow uppercase">{eyebrow}</span>}
        </p>
      )}
      <h2 id={headingId} class="mt-3 text-h2 text-ink">
        {title}
      </h2>
    </div>
    <slot name="aside" />
  </div>
  <div data-reveal style="--reveal-delay: 70ms" class="mt-8 md:mt-10">
    <slot />
  </div>
</section>
