---
import type { ResearchInterest } from "../content/profile";
interface Props {
  entries: ResearchInterest[];
}
const { entries } = Astro.props;
---

<ol class="grid gap-x-10 gap-y-8 sm:grid-cols-2" role="list">
  {entries.map((entry, index) => (
    <li class="border-t border-line pt-5">
      <p class="font-display text-sm tabular-nums text-accent">
        {String(index + 1).padStart(2, "0")}
      </p>
      <h3 class="mt-2 font-medium leading-snug tracking-tight">
        {entry.title}
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-muted">{entry.summary}</p>
    </li>
  ))}
</ol>
