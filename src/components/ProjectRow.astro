---
import type { Project } from "../data/projects";
import { projectLink } from "../data/links";
import HyphenSafeText from "./HyphenSafeText.astro";
import ProjectBadges from "./ProjectBadges.astro";
import ProjectLinks from "./ProjectLinks.astro";
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article
  class:list={[
    "relative grid gap-4 rounded-lg border border-hairline px-5 py-4 transition duration-200 ease-out hover:border-control motion-safe:hover:-translate-y-0.5 motion-safe:hover:shadow-[0_14px_40px_-14px_rgb(0_0_0/0.7)] motion-reduce:transition-none md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-8",
    "has-[[data-card-link]:focus-visible]:outline-2 has-[[data-card-link]:focus-visible]:outline-offset-4 has-[[data-card-link]:focus-visible]:outline-ink",
  ]}
>
  <div class="grid min-w-0 gap-2">
    <h4 class="m-0 text-body font-semibold text-ink">
      <a
        href={projectLink(project.slug)}
        data-card-link
        class="flex min-h-11 items-center after:absolute after:inset-0 after:rounded-lg focus-visible:outline-transparent!"
      >
        <span>
          <HyphenSafeText text={project.title} />
        </span>
      </a>
    </h4>
    <p class="m-0 max-w-reading text-small text-muted">
      <HyphenSafeText text={project.summary} />
    </p>
    <ProjectBadges project={project} />
  </div>
  <ProjectLinks project={project} caseStudy={false} />
</article>
