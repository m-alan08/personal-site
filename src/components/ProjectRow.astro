---
import type { Project } from "../data/projects";
import { projectLink } from "../data/links";
import ArrowIcon from "./ArrowIcon.astro";
import HyphenSafeText from "./HyphenSafeText.astro";
import ProjectBadges from "./ProjectBadges.astro";
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article
  class:list={[
    "group relative grid gap-x-10 gap-y-3 border-t border-hairline px-1 py-6 first:border-t-0 first:pt-0",
    "has-[[data-card-link]:focus-visible]:outline-2 has-[[data-card-link]:focus-visible]:outline-offset-4 has-[[data-card-link]:focus-visible]:outline-ink",
    "lg:grid-cols-[minmax(0,16rem)_minmax(0,1fr)_auto] lg:items-baseline",
  ]}
>
  <h4 class="m-0 text-h3 text-ink">
    <a
      href={projectLink(project.slug)}
      data-card-link
      class="inline-flex min-h-11 items-center gap-2 after:absolute after:inset-0 focus-visible:outline-transparent!"
    >
      <span>
        <HyphenSafeText text={project.title} />
      </span>
      <ArrowIcon class="text-muted transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none" />
    </a>
  </h4>
  <p class="m-0 max-w-reading text-small text-muted">
    <HyphenSafeText text={project.summary} />
  </p>
  <div class="m-0 lg:max-w-[14rem] lg:justify-self-end">
    <ProjectBadges project={project} />
  </div>
</article>
