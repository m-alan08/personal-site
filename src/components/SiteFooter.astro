---
import { site } from "../content/site";
import { localLinks } from "../data/links";
import ArrowIcon from "./ArrowIcon.astro";
const year = new Date().getFullYear();
---

<footer class="mx-auto mt-8 w-full max-w-4xl px-6 sm:px-10">
  <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-line py-8 text-sm text-muted">
    <p>
      © {year} {site.name}
    </p>
    <p>{site.footer}</p>
    <a
      href={localLinks.skip}
      class="group inline-flex min-h-11 items-center text-muted transition-colors duration-150 hover:text-ink motion-reduce:transition-none"
    >
      {site.backToTop}
      <ArrowIcon
        direction="up"
        class="ml-1.5 group-hover:-translate-y-1 group-focus-visible:-translate-y-1"
      />
    </a>
  </div>
</footer>
