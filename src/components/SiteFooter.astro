---
import { labels, site } from "../content/site";
import { localLinks, socialLinks } from "../data/links";
import ArrowIcon from "./ArrowIcon.astro";
import SocialIcons from "./SocialIcons.astro";
const year = new Date().getFullYear();
import { containerWidth } from "../data/layout";
interface Props {
  wide: boolean;
}
const { wide } = Astro.props;
const email = socialLinks.find((link) => link.kind === "email");
---

<footer
  id="contact"
  aria-labelledby="contact-heading"
  class:list={[
    "atmo-footer mx-auto w-full scroll-mt-8 px-6 sm:scroll-mt-20 sm:px-10",
    containerWidth(wide),
  ]}
>
  <div class="flex flex-wrap items-start justify-between gap-x-10 gap-y-8 border-t border-line py-10">
    <div class="min-w-0">
      <h2 id="contact-heading" class="text-h3 text-ink">
        {site.sections.contact}
      </h2>
      {email && (
        <p class="mt-2">
          <a
            href={email.href}
            class="inline-flex min-h-11 items-center text-ink underline decoration-accent/60 decoration-1 underline-offset-[5px] transition-colors duration-150 hover:decoration-accent motion-reduce:transition-none"
          >
            <span class="sr-only">{labels.email}: </span>
            {email.display}
          </a>
        </p>
      )}
      <p class="mt-4 max-w-reading text-small text-muted">{site.footer}</p>
      <p class="mt-2 text-label text-muted">
        © {year} {site.name}
      </p>
    </div>
    <div class="flex flex-col items-start gap-4 sm:items-end">
      <SocialIcons kinds={["github", "x", "linkedin", "resume"]} labeled />
      <a
        href={localLinks.skip}
        class="group inline-flex min-h-11 items-center text-small text-muted transition-colors duration-150 hover:text-accent motion-reduce:transition-none"
      >
        {site.backToTop}
        <ArrowIcon
          direction="up"
          class="ml-1.5 group-hover:-translate-y-1 group-focus-visible:-translate-y-1"
        />
      </a>
    </div>
  </div>
</footer>
