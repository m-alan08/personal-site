---
import { site } from "../content/site";
const year = new Date().getFullYear();
---

<footer class="mx-auto mt-8 w-full max-w-4xl px-6 sm:px-10">
  <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-line py-8 text-sm text-muted">
    <p>
      © {year} {site.name}
    </p>
    <p>{site.footer}</p>
  </div>
</footer>
