---
import { site } from "../content/site";
import { links } from "../data/links";
---

<footer class="mt-20 border-t border-line print:mt-8">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-3 px-6 py-8 sm:px-10">
    <p class="max-w-reading text-muted">{site.footer}</p>
    <a
      href={links.github}
      class="inline-flex min-h-11 items-center font-medium text-accent underline decoration-1 underline-offset-4"
    >
      GitHub
    </a>
  </div>
</footer>
