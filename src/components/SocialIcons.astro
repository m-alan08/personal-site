---
import { socialLinks, type SocialLink } from "../data/links";
import { socialIcons } from "../data/socialIcons";
const icons = socialIcons;
interface Props {
  kinds?: SocialLink["kind"][];
  labeled?: boolean;
}
const { kinds, labeled = false } = Astro.props;
const entries = socialLinks.filter(
  (link, index, all) =>
    all.findIndex((other) => other.kind === link.kind) === index &&
    (!kinds || kinds.includes(link.kind)),
);
---

<ul
  class:list={[
    "flex flex-wrap items-center",
    labeled ? "gap-2" : "-ml-3 gap-1",
  ]}
  role="list"
>
  {entries.map((link) => {
    const icon = icons[link.kind];
    return (
      <li>
        <a
          href={link.href}
          aria-label={labeled ? undefined : link.label}
          title={labeled ? undefined : link.label}
          class:list={[
            "inline-flex items-center rounded-md transition duration-200 motion-reduce:transition-none",
            labeled
              ? "min-h-11 gap-2 border border-control px-4 text-small text-ink hover:border-ink hover:bg-raised active:bg-line"
              : "size-11 justify-center text-muted hover:text-accent motion-safe:hover:-translate-y-0.5",
          ]}
        >
          <svg
            aria-hidden="true"
            viewBox={icon.viewBox}
            class:list={[labeled ? "size-4 text-muted" : "size-5"]}
            fill={icon.stroke ? "none" : "currentColor"}
            stroke={icon.stroke ? "currentColor" : "none"}
            stroke-width={icon.stroke ? 1.6 : undefined}
            stroke-linejoin="round"
          >
            <path d={icon.path} />
          </svg>
          {labeled && link.label}
        </a>
      </li>
    );
  })}
</ul>
