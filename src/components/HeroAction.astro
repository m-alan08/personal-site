---
interface Props {
  href: string;
  primary?: boolean;
}
const { href, primary = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex min-h-11 items-center justify-center rounded-md px-5 text-small font-medium transition-colors duration-150 motion-reduce:transition-none",
    primary
      ? "bg-ink text-canvas hover:bg-accent"
      : "border border-control text-ink hover:border-accent hover:text-accent",
  ]}
>
  <slot />
</a>
