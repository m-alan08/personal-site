---
import FigureCorners from "./FigureCorners.astro";

const motionLines = [
  { y: 70, start: 24 },
  { y: 86, start: 14 },
  { y: 102, start: 28 },
];
---

<svg
  viewBox="0 0 240 180"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="h-auto w-full max-w-[15rem]"
>
  <FigureCorners width={240} height={180} />
  <g class="stroke-line" stroke-width="1">
    {motionLines.map((line) => (
      <path d={`M${line.start} ${line.y} H40`}></path>
    ))}
  </g>
  <g class="stroke-muted/70 fill-canvas" stroke-width="1.25">
    <rect x="50" y="46" width="140" height="92" rx="3"></rect>
    <path d="M50 46 L120 100 L190 46"></path>
  </g>
  <path
    d="M50 138 L104 92 M190 138 L136 92"
    class="stroke-line"
    stroke-width="1"
  ></path>
  <g class="stroke-accent fill-canvas" stroke-width="1.25">
    <circle cx="120" cy="100" r="7"></circle>
    <circle cx="120" cy="100" r="1.75" class="fill-accent"></circle>
  </g>
</svg>
