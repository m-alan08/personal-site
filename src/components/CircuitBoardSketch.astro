---
import FigureCorners from "./FigureCorners.astro";

const pinOffsets = Array.from({ length: 6 }, (_, index) => index * 10);
const topTraces = pinOffsets.map((offset, index) => ({
  x: 95 + offset,
  end: 64 + Math.abs(index - 2.5) * 8,
}));
const sideTraces = pinOffsets.map((offset) => 125 + offset);
const bottomPins = pinOffsets.map((offset) => 95 + offset);
const highlightedPin = bottomPins[1];
const mountingHoles = [
  [36, 52],
  [204, 52],
  [36, 318],
  [204, 318],
];
---

<svg
  viewBox="0 0 240 360"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="h-auto w-full max-w-[15rem]"
>
  <FigureCorners width={240} height={360} />
  <g class="stroke-line" stroke-width="1">
    <rect x="24" y="40" width="192" height="290" rx="8"></rect>
    {mountingHoles.map(([x, y]) => (
      <circle cx={x} cy={y} r="4"></circle>
    ))}
    {topTraces.map((trace) => (
      <path d={`M${trace.x} 106 V${trace.end}`}></path>
    ))}
    {sideTraces.map((y) => (
      <path d={`M76 ${y} H56 M164 ${y} H184`}></path>
    ))}
    {bottomPins
      .filter((x) => x !== highlightedPin)
      .map((x) => (
        <path d={`M${x} 194 V300`}></path>
      ))}
    <rect x="100" y="130" width="40" height="40" rx="2"></rect>
  </g>
  <g class="stroke-line fill-canvas" stroke-width="1">
    {topTraces.map((trace) => (
      <circle cx={trace.x} cy={trace.end - 3} r="3"></circle>
    ))}
    {sideTraces.map((y) => (
      <>
        <circle cx="53" cy={y} r="3"></circle>
        <circle cx="187" cy={y} r="3"></circle>
      </>
    ))}
  </g>
  <g class="stroke-muted/70" stroke-width="1.25">
    {pinOffsets.map((offset) => (
      <path
        d={`M${95 + offset} 106 V114 M${95 + offset} 186 V194 M76 ${125 + offset} H84 M156 ${125 + offset} H164`}
      ></path>
    ))}
  </g>
  <g class="stroke-muted/70 fill-canvas" stroke-width="1.25">
    <rect x="84" y="114" width="72" height="72" rx="4"></rect>
    <rect x="84" y="300" width="72" height="14" rx="2"></rect>
  </g>
  <circle cx="93" cy="123" r="2" class="fill-muted/70"></circle>
  <g class="fill-muted/70">
    {bottomPins
      .filter((x) => x !== highlightedPin)
      .map((x) => (
        <rect x={x - 2} y="305" width="4" height="4"></rect>
      ))}
  </g>
  <g class="stroke-accent" stroke-width="1.25">
    <path d={`M${highlightedPin} 194 V300`}></path>
    <rect
      x={highlightedPin - 2}
      y="305"
      width="4"
      height="4"
      class="fill-accent"
    ></rect>
  </g>
</svg>
