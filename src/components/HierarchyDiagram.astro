---
import { figures } from "../content/figures";

const { layers, split, caption } = figures.hierarchy;
---

<figure class="max-w-[26rem]">
  <ol role="list">
    {layers.map((layer, index) => (
      <li>
        {index > 0 && (
          <div class="relative flex h-7 justify-center gap-6 lg:h-10">
            <svg
              aria-hidden="true"
              viewBox="0 0 12 40"
              class="h-7 w-3 text-muted lg:h-10"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M6 4v30M2 29l4 5 4-5" />
            </svg>
            <svg
              aria-hidden="true"
              viewBox="0 0 12 40"
              class="h-7 w-3 text-control lg:h-10"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-dasharray="3 3"
              stroke-linecap="round"
            >
              <path d="M6 36V6" />
            </svg>
            {index === 1 && (
              <div class="absolute inset-x-0 top-1/2 flex -translate-y-1/2 items-center gap-3">
                <span
                  aria-hidden="true"
                  class="h-0 flex-1 border-t border-dashed border-accent"
                ></span>
                <span class="bg-canvas text-label text-accent">{split}</span>
              </div>
            )}
          </div>
        )}
        <div class="flex flex-wrap items-baseline justify-center gap-x-3 gap-y-1 rounded-xl border border-hairline bg-surface px-4 py-2 text-center">
          <p class="font-medium text-ink">{layer.title}</p>
          <p class="text-label text-muted">{layer.detail}</p>
        </div>
      </li>
    ))}
  </ol>
  <figcaption class="mt-4 text-small text-muted">{caption}</figcaption>
</figure>
