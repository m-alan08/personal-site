---
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a
  href={href}
  class="inline-flex min-h-11 min-w-11 items-center py-2 font-medium text-accent underline decoration-1 underline-offset-4 transition-colors duration-150 hover:decoration-2 motion-reduce:transition-none"
>
  <slot />
</a>
