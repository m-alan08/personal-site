---
interface Props {
  href: string;
  label?: string;
}
const { href, label } = Astro.props;
---

<a
  href={href}
  aria-label={label}
  class="inline-flex min-h-11 min-w-11 items-center text-ink underline decoration-accent/60 decoration-1 underline-offset-[5px] transition-colors duration-150 hover:decoration-accent motion-reduce:transition-none"
>
  <slot />
</a>
