---
interface Props {
  value: string;
  label: string;
  accent?: boolean;
  class?: string;
}
const { value, label, accent = false, class: className } = Astro.props;
---

<div class:list={["min-w-0", className]}>
  <p
    class:list={[
      "text-h3 tabular-nums tracking-tight",
      accent ? "text-accent" : "text-ink",
    ]}
  >
    {value}
  </p>
  <p class="mt-1 text-label text-muted">{label}</p>
</div>
