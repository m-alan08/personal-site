---
import type { Project } from "../data/projects";
import { caseStudyExtras, caseStudyLabels } from "../content/caseStudyPage";
import CaseStudyHeader from "./CaseStudyHeader.astro";
import CaseStudyHighlight from "./CaseStudyHighlight.astro";
import CaseStudyImage from "./CaseStudyImage.astro";
import CaseStudyRail from "./CaseStudyRail.astro";
import CaseStudySection from "./CaseStudySection.astro";
import CaseStudySources from "./CaseStudySources.astro";
import PipelineStepper from "./PipelineStepper.astro";
interface Props {
  project: Project;
}
const { project } = Astro.props;
const extras = caseStudyExtras[project.slug];
const enhanceImages = extras?.enhanceImages ?? false;
const badges = [
  project.ownership,
  project.status,
  project.event?.name,
  ...(extras?.badges ?? []),
].filter((badge): badge is string => Boolean(badge));
const gallery = project.gallery ?? [];
const sections = [
  {
    id: "problem",
    title: caseStudyLabels.problem,
    paragraphs: [project.problem],
  },
  { id: "role", title: caseStudyLabels.role, paragraphs: [project.role] },
  {
    id: "approach",
    title: caseStudyLabels.approach,
    paragraphs: project.approach,
    extra: project.diagram !== null,
  },
  {
    id: "results",
    title:
      extras?.highlight.kind === "result"
        ? caseStudyLabels.results
        : caseStudyLabels.figures,
    paragraphs: [],
    extra: gallery.length > 0,
  },
  {
    id: "limitations",
    title: caseStudyLabels.limitations,
    paragraphs: project.limitations,
    list: true,
  },
  {
    id: "lessons",
    title: caseStudyLabels.lessons,
    paragraphs: project.lessons,
    list: true,
  },
  {
    id: "sources",
    title: caseStudyLabels.sources,
    paragraphs: [],
    extra: project.sources.length > 0,
  },
]
  .map((section) => ({
    ...section,
    paragraphs: section.paragraphs.filter(Boolean),
  }))
  .filter((section) => section.paragraphs.length > 0 || section.extra);
---

<article>
  <CaseStudyHeader
    project={project}
    badges={badges}
    enhanceImages={enhanceImages}
  />
  {extras && <CaseStudyHighlight highlight={extras.highlight} />}
  <div class="mt-16 grid gap-12 lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-16">
    <CaseStudyRail sections={sections} />
    <div class="min-w-0 space-y-14">
      {sections.map((section, index) => (
        <CaseStudySection
          id={section.id}
          number={index + 1}
          title={section.title}
          paragraphs={section.paragraphs}
          list={section.list}
        >
          {section.id === "approach" && project.diagram && (
            <PipelineStepper pipeline={project.diagram} />
          )}
          {section.id === "results" && (
            <div class="mt-6 space-y-10">
              {gallery.map((image) => (
                <CaseStudyImage
                  image={image}
                  sizes="(min-width: 1280px) 56rem, (min-width: 1024px) 70vw, 100vw"
                  enhance={enhanceImages}
                />
              ))}
            </div>
          )}
          {section.id === "sources" && (
            <CaseStudySources sources={project.sources} />
          )}
        </CaseStudySection>
      ))}
    </div>
  </div>
</article>
