---
import ConnectionGraph from "./ConnectionGraph.astro";
import type { Project } from "../data/projects";
import { caseStudy, labels, site } from "../content/site";
import TextLink from "./TextLink.astro";
import ArchitectureDiagram from "./ArchitectureDiagram.astro";
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article>
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-accent">
    <p>{project.category}</p>
    <p>{project.ownership}</p>
    {project.event && (
      <p>
        {project.event.name} {project.event.year} / {project.event.duration}
      </p>
    )}
  </div>
  <h1 class="mt-4 max-w-reading text-4xl font-semibold leading-tight tracking-tight sm:text-6xl">
    {project.title}
  </h1>
  <p class="mt-6 max-w-reading text-xl text-muted">{project.summary}</p>
  {project.event?.dates && (
    <p class="mt-4 text-muted">
      {project.event.dates}
      {project.event.location && `, ${project.event.location}`}
    </p>
  )}
  <div class="mt-8 flex flex-wrap gap-x-6">
    {project.repository && (
      <TextLink href={project.repository}>{labels.repository}</TextLink>
    )}
    {project.devpost && (
      <TextLink href={project.devpost}>{caseStudy.devpost}</TextLink>
    )}
  </div>
  <div class="mt-10 grid gap-10 border-t border-line pt-10 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_400px]">
    <div class="min-w-0 space-y-10">
      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          {caseStudy.problem}
        </h2>
        <p class="mt-4 max-w-reading text-muted">{project.problem}</p>
      </section>
      <section>
        <h2 class="text-2xl font-semibold tracking-tight">{caseStudy.role}</h2>
        <p class="mt-4 max-w-reading text-muted">{project.role}</p>
      </section>
      {project.approach.length > 0 && (
        <section>
          <h2 class="text-2xl font-semibold tracking-tight">
            {caseStudy.approach}
          </h2>
          <div class="mt-4 max-w-reading space-y-4 text-muted">
            {project.approach.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      )}
      {project.lessons.length > 0 && (
        <section>
          <h2 class="text-2xl font-semibold tracking-tight">
            {caseStudy.lessons}
          </h2>
          <ul class="mt-4 max-w-reading list-disc space-y-3 pl-5 text-muted">
            {project.lessons.map((lesson) => (
              <li>{lesson}</li>
            ))}
          </ul>
        </section>
      )}
    </div>
    <aside class="min-w-0 space-y-8">
      <section class="surface rounded-xl p-6">
        <h2 class="text-lg font-semibold">{caseStudy.status}</h2>
        <p class="mt-3 text-accent">{project.status}</p>
        {project.technology.length > 0 && (
          <>
            <h3 class="mt-6 font-semibold">{caseStudy.stack}</h3>
            <ul class="mt-3 flex flex-wrap gap-2" role="list">
              {project.technology.map((tool) => (
                <li class="rounded-sm bg-canvas px-2 py-1">{tool}</li>
              ))}
            </ul>
          </>
        )}
        {project.event && project.event.teammates.length > 0 && (
          <>
            <h3 class="mt-6 font-semibold">{caseStudy.team}</h3>
            <p class="mt-3 text-muted">
              {[site.name, ...project.event.teammates].join(", ")}
            </p>
          </>
        )}
      </section>
      {project.diagram && (
        <ArchitectureDiagram diagram={project.diagram} slug={project.slug} />
      )}
    </aside>
  </div>
  {project.interactive === "connections" && <ConnectionGraph />}
  <section class="mt-12 rounded-xl border-l-2 border-accent bg-surface p-6 sm:p-8">
    <h2 class="text-2xl font-semibold tracking-tight">
      {caseStudy.limitations}
    </h2>
    <div class="mt-4 max-w-reading space-y-3 text-muted">
      {project.limitations.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>
  {project.writeup.length > 0 && (
    <details class="mt-8 border-t border-line py-4">
      <summary class="min-h-11 cursor-pointer py-2 font-semibold text-accent">
        {labels.projectNotes}
      </summary>
      <div class="max-w-reading space-y-4 py-4 text-muted">
        {project.writeup.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </details>
  )}
  <section class="mt-12 border-t border-line pt-8">
    <h2 class="text-xl font-semibold">{labels.source}</h2>
    <p class="mt-3 max-w-reading text-muted">{project.sourceNote}</p>
    <div class="mt-4 flex flex-wrap gap-x-6">
      {project.sources.map((source) => (
        <TextLink href={source.href}>{source.label}</TextLink>
      ))}
    </div>
  </section>
</article>
