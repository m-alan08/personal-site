---
import { getImage } from "astro:assets";
import type { Project } from "../data/projects";
import { caseStudy, labels, site } from "../content/site";
import { externalLinks } from "../data/projectLinks";
import TextLink from "./TextLink.astro";
import ProjectImage from "./ProjectImage.astro";
import CaseStudySection from "./CaseStudySection.astro";
interface Props {
  project: Project;
}
const { project } = Astro.props;
const links = externalLinks(project);
const images = [project.image, ...(project.gallery ?? [])].filter(
  (image) => image !== undefined,
);
const fullSizeImages = await Promise.all(
  images.map((image) =>
    getImage({ src: image.src, format: "webp", quality: 85 }),
  ),
);
const meta = [
  project.ownership,
  project.event &&
    [project.event.name, project.event.year, project.event.duration]
      .filter(Boolean)
      .join(" "),
].filter(Boolean);
const facts = [
  { term: caseStudy.status, detail: project.status },
  { term: caseStudy.stack, detail: project.technology.join(", ") },
  {
    term: caseStudy.team,
    detail: project.event?.teammates.length
      ? [site.name, ...project.event.teammates].join(", ")
      : "",
  },
  {
    term: project.event?.name ?? "",
    detail: [project.event?.dates, project.event?.location]
      .filter(Boolean)
      .join(", "),
  },
].filter((fact) => fact.term && fact.detail);
---

<article class="max-w-reading">
  <p class="text-sm text-muted">{meta.join(" · ")}</p>
  <h1 class="mt-3 text-balance font-display text-4xl leading-tight tracking-tight">
    {project.title.split(" ").map((word, index) => (
      <>
        {index > 0 && " "}
        {word.includes("-") ? (
          <span class="whitespace-nowrap">{word}</span>
        ) : (
          word
        )}
      </>
    ))}
  </h1>
  <p class="mt-5 text-lg text-muted">{project.summary}</p>
  {links.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-x-6" role="list">
      {links.map((link) => (
        <li>
          <TextLink href={link.href}>{link.label}</TextLink>
        </li>
      ))}
    </ul>
  )}
  {images.length > 0 && (
    <ul class="mt-8 grid gap-3 sm:grid-cols-2" role="list">
      {images.map((image, index) => (
        <li>
          <a
            href={fullSizeImages[index]?.src}
            class="group block cursor-zoom-in rounded-lg"
          >
            <ProjectImage
              image={image}
              sizes="(min-width: 640px) 34ch, 100vw"
              eager={index === 0}
              class="transition-colors duration-150 group-hover:border-muted motion-reduce:transition-none"
            />
          </a>
        </li>
      ))}
    </ul>
  )}
  <dl class="mt-10 grid gap-x-8 gap-y-4 border-t border-line pt-8 text-sm sm:grid-cols-[8rem_minmax(0,1fr)]">
    {facts.map((fact) => (
      <>
        <dt class="text-muted">{fact.term}</dt>
        <dd class="m-0">{fact.detail}</dd>
      </>
    ))}
  </dl>
  <CaseStudySection title={caseStudy.problem} paragraphs={[project.problem]} />
  <CaseStudySection title={caseStudy.role} paragraphs={[project.role]} />
  <CaseStudySection title={caseStudy.approach} paragraphs={project.approach} />
  {project.diagram && (
    <section class="mt-12">
      <h2 class="font-display text-2xl italic tracking-tight">
        {project.diagram.title}
      </h2>
      <p class="mt-3 text-muted">{project.diagram.description}</p>
      <ol class="mt-5 space-y-3 border-l border-line pl-5" role="list">
        {project.diagram.nodes.map((node, index) => (
          <li>
            <p>
              <span class="mr-3 text-sm tabular-nums text-muted">
                {String(index + 1).padStart(2, "0")}
              </span>
              {node.title}
            </p>
            <p class="ml-8 text-sm text-muted">{node.detail}</p>
          </li>
        ))}
      </ol>
      <p class="mt-4 text-sm text-muted">{project.diagram.note}</p>
    </section>
  )}
  <CaseStudySection title={caseStudy.lessons} paragraphs={project.lessons} />
  <CaseStudySection
    title={caseStudy.limitations}
    paragraphs={project.limitations}
  />
  <CaseStudySection title={labels.projectNotes} paragraphs={project.writeup} />
  <section class="mt-12 border-t border-line pt-8 text-sm">
    <h2 class="font-medium">{labels.source}</h2>
    <p class="mt-3 text-muted">{project.sourceNote}</p>
    {project.sources.length > 0 && (
      <ul class="mt-2 flex flex-wrap gap-x-6" role="list">
        {project.sources.map((source) => (
          <li>
            <TextLink href={source.href}>{source.label}</TextLink>
          </li>
        ))}
      </ul>
    )}
  </section>
</article>
