---
import type { Pipeline } from "../data/projects";
import { caseStudyLabels } from "../content/caseStudyPage";
import HyphenSafeText from "./HyphenSafeText.astro";
interface Props {
  pipeline: Pipeline;
}
const { pipeline } = Astro.props;
const plannedPrefix = /^Planned:?\s*/;
const steps = pipeline.nodes.map((node) => ({
  title: node.title,
  planned: plannedPrefix.test(node.detail),
  detail: node.detail.replace(plannedPrefix, ""),
}));
---

<div class="mt-10">
  <h3 class="text-h3 text-ink">
    <HyphenSafeText text={pipeline.title} />
  </h3>
  <p class="mt-2 max-w-reading text-muted">
    <HyphenSafeText text={pipeline.description} />
  </p>
  <ol
    role="list"
    class="mt-6 grid gap-6 lg:auto-cols-fr lg:grid-flow-col lg:gap-8"
  >
    {steps.map((step, index) => (
      <li class="relative">
        <div
          class:list={[
            "flex h-full flex-col rounded-lg border p-4",
            step.planned
              ? "border-dashed border-control"
              : "border-line bg-surface",
          ]}
        >
          <p class="flex items-center justify-between gap-2 text-eyebrow uppercase text-muted">
            <span>
              <span class="sr-only">{caseStudyLabels.step} </span>
              {String(index + 1).padStart(2, "0")}
            </span>
            {step.planned && (
              <span class="rounded-sm border border-control px-1.5 py-0.5 text-ink">
                {caseStudyLabels.planned}
              </span>
            )}
          </p>
          <p class="mt-3 font-semibold leading-snug text-ink">
            <HyphenSafeText text={step.title} />
          </p>
          {step.detail && (
            <p class="mt-1 text-small text-muted">
              <HyphenSafeText text={step.detail} />
            </p>
          )}
        </div>
        {index < steps.length - 1 && (
          <>
            <svg
              aria-hidden="true"
              viewBox="0 0 12 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="absolute left-6 top-full h-6 w-3 -translate-x-1/2 text-control lg:hidden"
            >
              <path d="M6 2v19M2.5 17.5 6 21l3.5-3.5" />
            </svg>
            <svg
              aria-hidden="true"
              viewBox="0 0 32 12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="absolute left-full top-1/2 hidden h-3 w-8 -translate-y-1/2 text-control lg:block"
            >
              <path d="M3 6h26M25.5 2.5 29 6l-3.5 3.5" />
            </svg>
          </>
        )}
      </li>
    ))}
  </ol>
  {pipeline.note && (
    <p class="mt-4 max-w-reading text-small text-muted">
      <HyphenSafeText text={pipeline.note} />
    </p>
  )}
</div>
