---
import HyphenSafeText from "./HyphenSafeText.astro";
interface Props {
  title: string;
  paragraphs: string[];
}
const { title, paragraphs } = Astro.props;
const content = paragraphs.filter(Boolean);
---

{content.length > 0 && (
  <section class="mt-12">
    <h2 class="font-display text-2xl italic tracking-tight">
      <HyphenSafeText text={title} />
    </h2>
    <div class="mt-3 space-y-4 text-muted">
      {content.map((paragraph) => (
        <p>
          <HyphenSafeText text={paragraph} />
        </p>
      ))}
    </div>
  </section>
)}
