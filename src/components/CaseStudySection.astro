---
interface Props {
  title: string;
  paragraphs: string[];
}
const { title, paragraphs } = Astro.props;
const content = paragraphs.filter(Boolean);
---

{content.length > 0 && (
  <section class="mt-12">
    <h2 class="text-lg font-medium tracking-tight">{title}</h2>
    <div class="mt-3 space-y-4 text-muted">
      {content.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>
)}
