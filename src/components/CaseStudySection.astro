---
import HyphenSafeText from "./HyphenSafeText.astro";
interface Props {
  id: string;
  number: number;
  title: string;
  paragraphs: string[];
  list?: boolean;
}
const { id, number, title, paragraphs, list = false } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  class="border-t border-line pt-10 first:border-t-0 first:pt-0"
>
  <p aria-hidden="true" class="font-mono text-label tabular-nums text-muted">
    {String(number).padStart(2, "0")}
  </p>
  <h2 id={`${id}-heading`} class="mt-2 text-h2 text-ink">
    {title}
  </h2>
  {paragraphs.length > 0 &&
    (list ? (
      <ul role="list" class="mt-5 max-w-reading space-y-3">
        {paragraphs.map((paragraph) => (
          <li class="relative pl-6 before:absolute before:left-0 before:top-[0.7em] before:size-1.5 before:rounded-full before:bg-control before:content-['']">
            <HyphenSafeText text={paragraph} />
          </li>
        ))}
      </ul>
    ) : (
      <div class="mt-5 max-w-reading space-y-4">
        {paragraphs.map((paragraph) => (
          <p>
            <HyphenSafeText text={paragraph} />
          </p>
        ))}
      </div>
    ))}
  <slot />
</section>
