---
import { labels } from "../content/site";
import HyphenSafeText from "./HyphenSafeText.astro";
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{tags.length > 0 && (
  <p class="m-0 text-small text-muted">
    <span class="sr-only">{labels.technology}: </span>
    <HyphenSafeText text={tags.join(" · ")} />
  </p>
)}
