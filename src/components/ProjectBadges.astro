---
import type { Project } from "../data/projects";
import { ownershipLabels } from "../content/projectCards";
import HyphenSafeText from "./HyphenSafeText.astro";
interface Props {
  project: Project;
}
const { project } = Astro.props;
const parts = [
  ownershipLabels[project.ownership],
  project.event?.name ?? "",
].filter(Boolean);
---

<p class="m-0 flex flex-wrap items-center gap-x-3 gap-y-1 text-small text-muted">
  <span class="flex items-center gap-2">
    <span aria-hidden="true" class="size-1.5 rounded-full bg-ink/50"></span>
    <HyphenSafeText text={project.status} />
  </span>
  {parts.map((part) => (
    <span class="flex items-center gap-3">
      <span aria-hidden="true" class="text-line">
        ·
      </span>
      <HyphenSafeText text={part} />
    </span>
  ))}
</p>
