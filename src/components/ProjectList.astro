---
import type { Project } from "../data/projects";
import { projectCardLabels } from "../content/projectCards";
import ProjectCard from "./ProjectCard.astro";
import ProjectRow from "./ProjectRow.astro";
interface Props {
  features: Project[];
  inProgress: Project[];
}
const { features, inProgress } = Astro.props;
---

<div class="grid gap-6">
  {features.map((project, index) => (
    <ProjectCard project={project} eager={index === 0} accent={index === 0} />
  ))}
</div>
{inProgress.length > 0 && (
  <div class="mt-14">
    <h3 class="m-0 mb-2 text-eyebrow uppercase text-muted">
      {projectCardLabels.inProgress}
    </h3>
    {inProgress.map((project) => (
      <ProjectRow project={project} />
    ))}
  </div>
)}
