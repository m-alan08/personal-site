---
import type { Project } from "../data/projects";
import { projectCardLabels } from "../content/projectCards";
import ProjectCard from "./ProjectCard.astro";
import ProjectRow from "./ProjectRow.astro";
interface Props {
  features: Project[];
  standard: Project[];
  inProgress: Project[];
}
const { features, standard, inProgress } = Astro.props;
---

<div class="grid gap-6">
  {features.map((project, index) => (
    <ProjectCard
      project={project}
      size="feature"
      eager={index === 0}
      accent={index === 0}
    />
  ))}
  {standard.length > 0 && (
    <div class="grid gap-6 md:grid-cols-2">
      {standard.map((project) => (
        <ProjectCard project={project} size="medium" />
      ))}
    </div>
  )}
</div>
{inProgress.length > 0 && (
  <div class="mt-12 grid gap-4">
    <h3 class="m-0 font-mono text-label uppercase text-muted">
      {projectCardLabels.inProgress}
    </h3>
    {inProgress.map((project) => (
      <ProjectRow project={project} />
    ))}
  </div>
)}
