---
import { figures } from "../content/figures";

const labels = figures.loop;
const head = 4;
const arrowUp = (x: number, y: number) =>
  `M${x - head} ${y + head * 1.5} L${x} ${y} L${x + head} ${y + head * 1.5}`;
const arrowDown = (x: number, y: number) =>
  `M${x - head} ${y - head * 1.5} L${x} ${y} L${x + head} ${y - head * 1.5}`;
const arrowRight = (x: number, y: number) =>
  `M${x - head * 1.5} ${y - head} L${x} ${y} L${x - head * 1.5} ${y + head}`;
---

<svg
  viewBox="0 0 240 196"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="h-auto w-full max-w-[15rem]"
>
  <g class="stroke-muted/70" stroke-width="1.25">
    <rect x="24" y="12" width="192" height="40" rx="3"></rect>
    <rect x="24" y="144" width="192" height="40" rx="3"></rect>
    <path d="M56 144 V53"></path>
    <path d={arrowUp(56, 53)}></path>
  </g>
  <g class="stroke-line" stroke-width="1.25" stroke-dasharray="3 3">
    <rect x="80" y="80" width="80" height="44" rx="3"></rect>
    <path d="M56 102 H78 M120 80 V53"></path>
  </g>
  <g class="stroke-line" stroke-width="1.25">
    <path d={arrowRight(79, 102)}></path>
    <path d={arrowUp(120, 53)}></path>
  </g>
  <g class="stroke-accent" stroke-width="1.25">
    <path d="M184 52 V143"></path>
    <path d={arrowDown(184, 143)}></path>
  </g>
  <g text-anchor="middle">
    <text x="120" y="36" font-size="13" class="fill-ink font-display italic">
      {labels.policy}
    </text>
    <text x="120" y="161" font-size="11" class="fill-ink">
      {labels.environment}
    </text>
    <text x="120" y="175" font-size="9.5" class="fill-muted">
      {labels.environmentDetail}
    </text>
    <text x="120" y="98" font-size="9.5" class="fill-muted">
      {labels.buffer}
    </text>
    <text x="120" y="114" font-size="11" class="fill-muted font-display italic">
      {labels.relabel}
    </text>
  </g>
  <text x="192" y="102" font-size="12" class="fill-accent font-display italic">
    {labels.action}
  </text>
  <text
    x="50"
    y="128"
    font-size="12"
    text-anchor="end"
    class="fill-muted font-display italic"
  >
    {labels.observation}
  </text>
</svg>
