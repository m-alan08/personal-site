---
import type { Project } from "../data/projects";
import { projectLink } from "../data/links";
import { projectCardLabels } from "../content/projectCards";
import ButtonLink from "./ButtonLink.astro";
interface Props {
  project: Project;
  caseStudy?: boolean;
}
const { project, caseStudy = true } = Astro.props;
const linkOrder = ["repository", "demo"];
const external = (project.links ?? [])
  .filter((link) => linkOrder.includes(link.kind))
  .sort((a, b) => linkOrder.indexOf(a.kind) - linkOrder.indexOf(b.kind))
  .slice(0, 1);
---

<ul class="relative z-10 m-0 flex list-none flex-wrap gap-2 p-0" role="list">
  {caseStudy && (
    <li>
      <ButtonLink href={projectLink(project.slug)} arrow>
        {projectCardLabels.caseStudy}
        <span class="sr-only">: {project.title}</span>
      </ButtonLink>
    </li>
  )}
  {external.map((link) => (
    <li>
      <ButtonLink href={link.href}>
        {link.label}
        <span class="sr-only">: {project.title}</span>
      </ButtonLink>
    </li>
  ))}
</ul>
