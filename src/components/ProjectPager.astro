---
import type { Project } from "../data/projects";
import { projectLink } from "../data/links";
import { labels } from "../content/site";
import ArrowIcon from "./ArrowIcon.astro";
import HyphenSafeText from "./HyphenSafeText.astro";
interface Props {
  previous?: Project;
  next?: Project;
}
const { previous, next } = Astro.props;
---

<nav
  aria-label={labels.moreProjects}
  class="mt-16 grid max-w-reading gap-4 border-t border-line pt-8 sm:grid-cols-2"
>
  {previous && (
    <a
      href={projectLink(previous.slug)}
      class="group flex min-h-11 flex-col rounded-lg border border-line p-4 transition-colors duration-150 hover:border-control motion-reduce:transition-none"
    >
      <span class="text-xs uppercase tracking-[0.2em] text-muted">
        <ArrowIcon
          direction="left"
          class="mr-1.5 group-hover:-translate-x-1 group-focus-visible:-translate-x-1"
        />
        {labels.previousProject}
      </span>
      <span class="mt-2 font-medium leading-snug group-hover:text-accent">
        <HyphenSafeText text={previous.title} />
      </span>
    </a>
  )}
  {next && (
    <a
      href={projectLink(next.slug)}
      class="group flex min-h-11 flex-col rounded-lg border border-line p-4 text-right transition-colors duration-150 hover:border-control motion-reduce:transition-none sm:col-start-2"
    >
      <span class="text-xs uppercase tracking-[0.2em] text-muted">
        {labels.nextProject}
        <ArrowIcon class="ml-1.5 group-hover:translate-x-1 group-focus-visible:translate-x-1" />
      </span>
      <span class="mt-2 font-medium leading-snug group-hover:text-accent">
        <HyphenSafeText text={next.title} />
      </span>
    </a>
  )}
</nav>
