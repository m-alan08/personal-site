---
import type { Project } from "../data/projects";
import { projectLink } from "../data/links";
import { labels } from "../content/site";
import ArrowIcon from "./ArrowIcon.astro";
import HyphenSafeText from "./HyphenSafeText.astro";
interface Props {
  previous?: Project;
  next?: Project;
}
const { previous, next } = Astro.props;
const cardClass =
  "group flex min-h-11 flex-col rounded-xl border border-line bg-surface p-5 transition-colors duration-150 hover:border-control motion-reduce:transition-none sm:p-6";
---

<nav
  aria-label={labels.moreProjects}
  class="mt-20 grid gap-4 border-t border-line pt-10 sm:grid-cols-2"
>
  {previous && (
    <a href={projectLink(previous.slug)} class={cardClass}>
      <span class="text-eyebrow uppercase text-muted">
        <ArrowIcon
          direction="left"
          class="mr-1.5 group-hover:-translate-x-1 group-focus-visible:-translate-x-1"
        />
        {labels.previousProject}
      </span>
      <span class="mt-3 text-h3 text-ink group-hover:text-accent">
        <HyphenSafeText text={previous.title} />
      </span>
    </a>
  )}
  {next && (
    <a
      href={projectLink(next.slug)}
      class:list={[cardClass, "text-right sm:col-start-2"]}
    >
      <span class="text-eyebrow uppercase text-muted">
        {labels.nextProject}
        <ArrowIcon class="ml-1.5 group-hover:translate-x-1 group-focus-visible:translate-x-1" />
      </span>
      <span class="mt-3 text-h3 text-ink group-hover:text-accent">
        <HyphenSafeText text={next.title} />
      </span>
    </a>
  )}
</nav>
