---
import {
  bitWidths,
  datasets,
  explorerCopy,
  methods,
  type Measurement,
} from "../../data/explorerData";
import { chartFrame, chartTicks, chartX, chartY } from "./chart";

const series = datasets.flatMap((dataset) =>
  methods.map((method) => {
    const points = bitWidths.map((bits, index) => {
      const measurement: Measurement | null = dataset.results[method.id][bits];
      return measurement
        ? {
            bits,
            value: measurement[0],
            x: chartX(index, bitWidths.length),
            y: chartY(measurement[0]),
          }
        : null;
    });
    const segments = points
      .reduce<(typeof points)[]>(
        (runs, point) => {
          if (point) runs[runs.length - 1].push(point);
          else runs.push([]);
          return runs;
        },
        [[]],
      )
      .filter((run) => run.length > 0);
    return {
      task: dataset.task,
      method: method.id,
      points: points.filter((point) => point !== null),
      lines: segments.map((run) =>
        run.map((point) => `${point?.x},${point?.y}`).join(" "),
      ),
    };
  }),
);
---

<figure>
  <svg
    viewBox={`0 0 ${chartFrame.width} ${chartFrame.height}`}
    class="block h-auto w-full font-mono"
    aria-hidden="true"
    focusable="false"
  >
    {chartTicks.map((tick) => (
      <g>
        <line
          x1={chartFrame.left}
          x2={chartFrame.width - chartFrame.right}
          y1={chartY(tick)}
          y2={chartY(tick)}
          stroke="var(--line)"
        />
        <text
          x={chartFrame.left - 8}
          y={chartY(tick) + 4}
          text-anchor="end"
          font-size="11"
          fill="var(--muted)"
        >
          {`${tick}%`}
        </text>
      </g>
    ))}
    {bitWidths.map((bits, index) => (
      <text
        x={chartX(index, bitWidths.length)}
        y={chartFrame.labelY}
        text-anchor="middle"
        font-size="11"
        fill="var(--muted)"
      >
        {bits}
      </text>
    ))}
    {series.map((entry) => (
      <g
        data-series
        data-task={entry.task}
        data-method={entry.method}
        display="none"
        stroke="var(--control)"
        stroke-width="1.5"
        fill="none"
      >
        {entry.lines.map((points) => (
          <polyline points={points} stroke-linejoin="round" />
        ))}
        {entry.points.map((point) => (
          <circle
            data-point
            data-task={entry.task}
            data-method={entry.method}
            data-bits={point.bits}
            data-value={point.value}
            cx={point.x}
            cy={point.y}
            r="3"
            fill="var(--canvas)"
          />
        ))}
      </g>
    ))}
    <circle
      data-explorer-marker
      r="6"
      fill="var(--accent)"
      stroke="var(--canvas)"
      stroke-width="2"
      display="none"
    ></circle>
  </svg>
  <figcaption class="mt-3 text-small text-muted">
    {explorerCopy.chartCaption}
  </figcaption>
</figure>
