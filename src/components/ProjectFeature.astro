---
import type { Project } from "../data/projects";
import { projectLink } from "../data/links";
import { headlineResults, projectCardLabels } from "../content/projectCards";
import HyphenSafeText from "./HyphenSafeText.astro";
import ProjectLinks from "./ProjectLinks.astro";
import ProjectThumb from "./ProjectThumb.astro";
interface Props {
  project: Project;
  eager?: boolean;
  accent?: boolean;
}
const { project, eager = false, accent = false } = Astro.props;
const headline = headlineResults[project.slug];
---

<article class="flex flex-col overflow-hidden rounded-lg border border-hairline bg-raised/30">
  <ProjectThumb
    project={project}
    eager={eager}
    flush
    sizes="(min-width: 1024px) 23rem, 100vw"
  />
  <div class="flex flex-1 flex-col gap-3 p-6">
    <h3 class="m-0 text-h3 text-ink">
      <a
        href={projectLink(project.slug)}
        class="inline-block py-2 transition-colors duration-150 hover:text-accent motion-reduce:transition-none"
      >
        <HyphenSafeText text={project.title} />
      </a>
    </h3>
    <p class="m-0 text-muted">
      <HyphenSafeText text={project.question} />
    </p>
    {headline && (
      <p class="m-0 mt-auto pt-4">
        <span class="sr-only">{projectCardLabels.result}: </span>
        <span
          class:list={[
            "block font-display text-h1 tabular-nums",
            accent ? "text-accent" : "text-ink",
          ]}
        >
          {headline.value}
        </span>
        <span class="mt-1 block text-muted">
          <HyphenSafeText text={headline.detail} />
        </span>
      </p>
    )}
    <div class="mt-4">
      <ProjectLinks project={project} />
    </div>
  </div>
</article>
