---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../content/site";
import "../styles/global.css";
import { structuredData } from "../data/structuredData";
import { sharePages } from "../data/routes";
import { localPath } from "../data/links";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const sharePage =
  sharePages.find((page) => localPath(page.path) === Astro.url.pathname) ??
  sharePages[0];
const shareImage = new URL(localPath(`og/${sharePage.slug}.png`), Astro.site);
const canonical = new URL(
  noindex ? localPath("404.html") : Astro.url.pathname,
  Astro.site,
);
const pageTitle = title === site.name ? site.title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    {!noindex && Astro.site && (
      <script
        is:inline
        type="application/ld+json"
        set:html={structuredData(Astro.site, canonical, pageTitle, description)}
      />
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={localPath("favicon.svg")} />
    <link rel="sitemap" href={localPath("sitemap.xml")} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${sharePage.title} | ${site.name}`}
    />
    <meta name="twitter:image" content={shareImage.href} />
    <meta
      name="twitter:image:alt"
      content={`${sharePage.title} | ${site.name}`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas text-ink">
    <SiteHeader />
    <main
      id="main-content"
      class="mx-auto w-full max-w-6xl flex-1 px-6 pt-14 sm:px-10 sm:pt-20"
      tabindex="-1"
    >
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
